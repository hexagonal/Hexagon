// The persistent 32-way bit-partitioned trie backing `Vector(a)` (Collections
// Part 3 §4), written over the hidden fixed-32 `Node` intrinsic. This is a
// runtime-internal module: it is compiled only as a privileged runtime module,
// and `Tree`, `Node`, and `TrieVector` never cross a module boundary — the
// public face is `Vector(a)`, wired by the emitter (a later milestone). Index
// math uses `Int.div`/`Int.mod` by the branch factor; Hexagon has no bitwise
// operators, and none are needed.

// A trie node is either a leaf holding up to 32 values, or a branch holding up
// to 32 child subtrees. Both are 32-slot `Node`s; which slots are populated is
// tracked by the enclosing `TrieVector`'s count, never by reading empty slots.
union Tree(a) =
    | Leaf(values: Node(a))
    | Branch(children: Node(Tree(a)))

// The Vector representation, following Immutable.js's List. `root` is a fully
// packed trie holding the leading `count - tailLen` elements (always a multiple
// of 32); `tail` is the trailing append buffer holding the final `tailLen`
// elements (1..32, or 0 only for the empty vector). Appends land in the tail for
// amortized O(1); when the tail fills it is flushed into `root` as one leaf.
// `height` counts `root`'s levels: 1 => a `Leaf`, 2 => a `Branch` of leaves.
// (The origin/capacity machinery for O(1) *prepend* — §4.1's other end — is a
// later increment; this slab appends only.)
record TrieVector(a) = {
    count: Int,
    height: Int,
    root: Tree(a),
    tail: Node(a),
    tailLen: Int,
}

// Signals a structurally malformed trie (a runtime bug, never a caller error).
// Thrown only on paths a well-formed trie can never take.
exception TrieCorruption(message: String)

// The branch factor. A `Node` is always exactly this wide.
let radix: Int = 32

fun empty<a>(): TrieVector(a) =
    TrieVector({
        count: 0,
        height: 1,
        root: Leaf(Node.empty()),
        tail: Node.empty(),
        tailLen: 0,
    })

fun size<a>(trie: TrieVector(a)): Int = trie.count

fun isEmpty<a>(trie: TrieVector(a)): Bool = trie.count == 0

// `radix` raised to `exponent` (exponent >= 0), computed without a power
// operator. `leafCapacity(height) = pow32(height - 1)` is the number of leaves a
// height-`h` trie holds when full.
fun pow32(exponent: Int): Int =
    var result = 1
    for step in 1..exponent
        result := result * radix
    result

// Reads the element at 0-based `index`. The trailing `tailLen` elements live in
// the tail; the rest are found by descending `root` one branch level per
// iteration to the owning leaf, then selecting the low digit within it. Callers
// guarantee `0 <= index < count`; a packed trie's slots are always populated
// along the path, so no empty `Node` slot is ever read.
fun get<a>(trie: TrieVector(a), index: Int): a =
    let rootCount = trie.count - trie.tailLen
    if index >= rootCount then
        Node.get(trie.tail, index - rootCount)
    else
        var node: Tree(a) = trie.root
        var span = pow32(trie.height - 1)
        var remaining = index
        // A height-`h` trie has `h - 1` branch levels above its leaves.
        for level in 2..trie.height
            node := match node
                Branch(children) => Node.get(children, Int.div(remaining, span))
                Leaf(_) => node
            remaining := Int.mod(remaining, span)
            span := Int.div(span, radix)
        match node
            Leaf(values) => Node.get(values, remaining)
            // Unreachable for a packed trie (the loop always lands on a leaf).
            Branch(_) => throw(TrieCorruption("get: descent did not reach a leaf"))

// Wraps `leaf` in `levels` fresh branch nodes, forming the left spine of a new
// subtree. `newPath(0, leaf) = leaf`.
fun newPath<a>(levels: Int, leaf: Tree(a)): Tree(a) =
    var node: Tree(a) = leaf
    for step in 1..levels
        node := Branch(Node.set(Node.empty(), 0, node))
    node

// Inserts `leaf` at 0-based leaf position `p` into a copy of `node` (a height-`h`
// subtree with room for it). Left-packed: `p`'s digit at this level is a new
// child exactly when the position within that child is 0. Recursion depth is
// bounded by `h` (<= ~7 for billions of elements), so this is stack-safe.
fun insertLeaf<a>(node: Tree(a), height: Int, p: Int, leaf: Tree(a)): Tree(a) =
    match node
        // Only reached at height 1: the empty root leaf is replaced by the first
        // flushed leaf.
        Leaf(_) => leaf
        Branch(children) =>
            let childLeaves = pow32(height - 2)
            let childIndex = Int.div(p, childLeaves)
            let childPos = Int.mod(p, childLeaves)
            if childPos == 0 then
                Branch(Node.set(children, childIndex, newPath(height - 2, leaf)))
            else
                let child = Node.get(children, childIndex)
                Branch(Node.set(children, childIndex, insertLeaf(child, height - 1, childPos, leaf)))

// Flushes a full tail (as `Leaf(tail)`) into `root`, returning the new root and
// its height. `rootCount` is the element count already in `root` (a multiple of
// 32). When `root` is full at its height, the trie grows one level.
fun flushLeaf<a>(root: Tree(a), height: Int, rootCount: Int, leaf: Tree(a)): (Tree(a), Int) =
    let leafPos = Int.div(rootCount, radix)
    let capacity = pow32(height - 1)
    if leafPos == capacity then
        // Root is full: a new level whose slot 0 is the old root and slot 1 is a
        // fresh spine down to the new leaf.
        let grown = Branch(Node.set(Node.set(Node.empty(), 0, root), 1, newPath(height - 1, leaf)))
        (grown, height + 1)
    else
        (insertLeaf(root, height, leafPos, leaf), height)

fun append<a>(trie: TrieVector(a), value: a): TrieVector(a) =
    if trie.tailLen < radix then
        TrieVector({
            count: trie.count + 1,
            height: trie.height,
            root: trie.root,
            tail: Node.set(trie.tail, trie.tailLen, value),
            tailLen: trie.tailLen + 1,
        })
    else
        // Tail is full: flush it as one leaf, then start a fresh tail.
        let rootCount = trie.count - trie.tailLen
        let (newRoot, newHeight) = flushLeaf(trie.root, trie.height, rootCount, Leaf(trie.tail))
        TrieVector({
            count: trie.count + 1,
            height: newHeight,
            root: newRoot,
            tail: Node.set(Node.empty(), 0, value),
            tailLen: 1,
        })
