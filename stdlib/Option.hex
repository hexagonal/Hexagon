module Option

// The canonical optional-value union used by total standard-library accessors.
export union Option(a) derives (Eq, Show) =
    | Some(value: a)
    | None

(** Transforms a present value. `None` stays `None`. *)
export let map(source: Option(a), transform: a ->! b): Option(b) =
    match source
        Some(value) => Some(transform!(value))
        None => None

(** Transforms a present value without adding another `Option` layer. *)
export let flatMap(source: Option(a), transform: a ->! Option(b)): Option(b) =
    match source
        Some(value) => transform!(value)
        None => None

(** Returns the present value, or the already-evaluated `fallback`. *)
export let defaultValue(source: Option(a), fallback: a): a =
    match source
        Some(value) => value
        None => fallback

(** Returns the present value, or calls `fallback` for `None`. *)
export let defaultWith(source: Option(a), fallback: () ->! a): a =
    match source
        Some(value) => value
        None => fallback!()

(** Converts `Some(value)` to a singleton sequence and `None` to an empty one. *)
export let toSeq(source: Option(a)): Seq(a) =
    match source
        Some(value) => Seq.singleton(value)
        None => Seq.empty

(** Returns the present value, or throws the exception `failure` builds for
    `None`. It may fail on its own account, so every call wears `^`:
    `name.orThrow^(() => MissingNameError)`. The exception is built only for
    `None`, so its stack is captured at the throw. *)
export let orThrow(source: Option(a), failure: () -> Exn): a =
    match source
        Some(value) => value
        None => throw^(failure())

(** `Ok` of the present value, or, for `None`, `Err` of the exception `failure`
    builds. It throws nothing, so its calls are bare:
    `name.toResult(() => MissingNameError)`. The exception is built only for
    `None`, so its stack is captured where it is kept. *)
export let toResult(source: Option(a), failure: () -> Exn): Result(a) =
    match source
        Some(value) => Ok(value)
        None => Err(failure())

(** Whether a value is present. It reads the constructor only, so it asks for no
    `Eq` on the value, where `source == None` would. *)
export let isSome(source: Option(a)): Bool =
    match source
        Some(_) => True
        None => False

(** Whether no value is present. *)
export let isNone(source: Option(a)): Bool =
    match source
        Some(_) => False
        None => True
