module Hash

(** The polymorphic face of hashing, and the key contract of the hash-backed
    collections. Instances are derived rather than hand-written, which is what
    keeps the law below true by construction. *)
export constraint Hash<a: Eq> =
    (** A hash of `value`. Equal values hash equally; unequal values may collide,
        and the hash is not resistant to an adversary choosing them. *)
    hash(value: a): Int
