// The public `BigInt` companion. A primitive's home module is its fixed prelude
// companion (Constraints §5.3), so this file is where `BigInt`'s instances are
// declared and where the orphan rule lets them be declared.

// The natives, and only the natives. An own-operation member body cannot be
// written in operators or interpolation — that sugar selects the very slot being
// defined (Constraints §6.1) — so every such member is a one-line delegation to
// one of the declarations below. Everything expressible over strictly simpler
// operations is ordinary Hexagon further down: the Euclidean pair over the
// truncated one, `gcd`'s loop over `rem`, `lcm` over `gcd`, and every guard.
extern from "hex:intrinsic"
    fun bigIntAdd as nativeAdd(left: BigInt, right: BigInt): BigInt
    fun bigIntMultiply as nativeMultiply(left: BigInt, right: BigInt): BigInt
    fun bigIntFromNat as nativeFromNat(value: Nat): BigInt
    fun bigIntSubtract as nativeSubtract(left: BigInt, right: BigInt): BigInt
    fun bigIntNegate as nativeNegate(value: BigInt): BigInt
    fun bigIntFromInt as nativeFromInt(value: Int): BigInt
    fun bigIntEquals as nativeEquals(left: BigInt, right: BigInt): Bool
    fun bigIntCompare as nativeCompare(left: BigInt, right: BigInt): Ordering
    fun bigIntShow as nativeShow(value: BigInt): String
    fun bigIntPow as nativePow(value: BigInt, exponent: BigInt): BigInt
    fun bigIntHash as nativeHash(value: BigInt): Int
    fun bigIntQuot as nativeQuot(left: BigInt, right: BigInt): BigInt
    fun bigIntRem as nativeRem(left: BigInt, right: BigInt): BigInt
    fun bigIntToIntUnchecked as toIntUnchecked(value: BigInt): Int
    fun bigIntToFloatUnchecked as toFloatUnchecked(value: BigInt): Float

honor Num<BigInt> =
    (** The sum of `left` and `right`, exactly. *)
    add(left, right) = nativeAdd(left, right)
    (** The product of `left` and `right`, exactly. *)
    multiply(left, right) = nativeMultiply(left, right)
    (** The natural number `value` as a `BigInt`. Total and exact. *)
    fromNat(value) = nativeFromNat(value)

honor Signed<BigInt> =
    (** The difference of `left` and `right`, exactly. *)
    subtract(left, right) = nativeSubtract(left, right)
    (** The additive inverse of `value`. *)
    negate(value) = nativeNegate(value)
    (** The integer `value` as a `BigInt`. Total and exact — every `Int` is a
        `BigInt`. *)
    fromInt(value) = nativeFromInt(value)

honor Eq<BigInt> =
    (** Whether `left` and `right` are the same integer. *)
    equals(left, right) = nativeEquals(left, right)

honor Ord<BigInt> =
    (** How `left` orders against `right`, by numeric value. *)
    compare(left, right) = nativeCompare(left, right)

honor Show<BigInt> =
    (** The decimal form of `value`, with no `n` suffix — `1n` shows as `1`. *)
    show(value) = nativeShow(value)

(** `value` raised to the power `exponent`, exactly — the door for exponents
    past `Int`'s range, whose useful domain the host defines: `0`, `1`, and `-1`
    answer at any non-negative exponent, and elsewhere the same implementation
    limits govern that govern all `BigInt` growth. Throws
    `NegativeExponentError` when `exponent` is negative — a negative power of an
    integer is not an integer — at this face and at `**` alike, the guard living
    once in this one body. *)
widens Pow.pow(value: BigInt, exponent: BigInt): BigInt =
    if exponent < 0 then
        throw(NegativeExponentError("an integer exponent cannot be negative"))
    else
        nativePow(value, exponent)

honor Pow<BigInt> =
    pow = widened

honor Hash<BigInt> =
    (** A hash of `value`. Equal `BigInt`s hash equally, which is what `Eq` above
        is checked against. *)
    hash(value) = nativeHash(value)

honor Integral<BigInt> =
    (** The truncated quotient of `left` divided by `right`, rounding toward
        zero. Throws `DivideByZeroError` when `right` is zero. *)
    quot(left, right) =
        if right == 0 then
            throw(DivideByZeroError("BigInt.quot: divisor is zero"))
        else
            nativeQuot(left, right)

    (** The truncated remainder of `left` divided by `right`, taking the sign of
        `left` — this is JS's `%`. Throws `DivideByZeroError` when `right` is
        zero, where JS would answer `NaN` or throw a `RangeError`. *)
    rem(left, right) =
        if right == 0 then
            throw(DivideByZeroError("BigInt.rem: divisor is zero"))
        else
            nativeRem(left, right)

    (** The Euclidean remainder of `left` divided by `right`: always
        non-negative, whatever the signs. Throws `DivideByZeroError` when
        `right` is zero. *)
    mod(left, right) =
        if right == 0 then
            throw(DivideByZeroError("BigInt.mod: divisor is zero"))
        else
            // `rem` and `mod` are spelled through their declaring module here
            // and below: `Float.hex` exports plain functions of both names and
            // seats before this file, so the bare spellings have two exporters
            // and are refused (Modules §5.5). The qualified home is the
            // refusal's own named repair, and it selects this very row.
            let remainder = Integral.rem(left, right)
            if remainder < 0 then
                remainder + (if right < 0 then -right else right)
            else
                remainder

    (** The Euclidean quotient of `left` divided by `right`: the unique partner
        of `mod` satisfying `div(l, r) * r + mod(l, r) == l`. Throws
        `DivideByZeroError` when `right` is zero. *)
    div(left, right) =
        if right == 0 then
            throw(DivideByZeroError("BigInt.div: divisor is zero"))
        else
            quot(left - Integral.mod(left, right), right)

    (** The greatest common divisor of `left` and `right`, never negative.
        `gcd(value, 0)` is the magnitude of `value`, so `gcd(0, 0)` is zero; it
        never throws. *)
    gcd(left, right) =
        var larger = if left < 0 then -left else left
        var smaller = if right < 0 then -right else right
        // Both operands are non-negative from here, so the loop's `rem` never
        // sees a zero divisor: a zero `smaller` is the exit condition.
        while smaller != 0
            let next = Integral.rem(larger, smaller)
            larger := smaller
            smaller := next
        larger

// The largest magnitude an `Int` holds exactly: 2^53 - 1.
let intLimit: BigInt = 9_007_199_254_740_991n

(** The least common multiple of `left` and `right`, never negative. It is zero
    when either operand is, and never throws. Dividing before multiplying keeps
    the intermediate small and is the form to copy at a fixed-width type. *)
export let lcm(left: BigInt, right: BigInt): BigInt =
    if left == 0 or right == 0 then
        0
    else
        let multiple = quot(left, gcd(left, right)) * right
        if multiple < 0 then -multiple else multiple

(** `value` as an `Int`, or `None` when its magnitude is past the range an `Int`
    holds exactly. The total direction is `BigInt.fromInt`. *)
export let toInt(value: BigInt): Option(Int) =
    if value < -intLimit or value > intLimit then
        None
    else
        Some(toIntUnchecked(value))

// `FloatRangeError` is `Float.hex`'s, in scope through the prelude: the range
// that fails belongs to `Float`, not to any one door into it. Throwing it is
// what seats this companion after `Float.hex` in the prelude order.
(** `value` as the nearest `Float` — correctly rounded, ties to even; past 2^53
    that double need not be the integer asked for, and no exception attends the
    rounding. Throws `FloatRangeError` where the correctly rounded answer would
    be an infinity. *)
export let toFloat(value: BigInt): Float =
    let approx = toFloatUnchecked(value)
    if Float.isFinite(approx) then
        approx
    else
        throw(FloatRangeError("BigInt.toFloat: value does not fit in Float"))
