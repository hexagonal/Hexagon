module Float

// The public `Float` companion. A primitive's home module is its fixed prelude
// companion (Constraints §5.3), so this file is where `Float`'s instances are
// declared and where the orphan rule lets them be declared.

// The one exception this file declares, and the one nothing in this file
// throws: `Float`'s own partiality is `NaN`, so no operation below guards. It
// belongs to the doors *into* `Float` from the exact world — `Rat.toFloat`
// today — because the range that fails is `Float`'s, stated once where every
// such door can share it (the `DivideByZeroError`-in-`Integral.hex` pattern),
// and because the brand follows the declaring module, so this home never has to
// move.
(** Raised when an exact value has no `Float` that approximates it: past
    `Float`'s finite range, or nonzero yet small enough to erase to zero.
    `message` names the operation that threw. *)
export exception FloatRangeError(message: String)

// The natives, and only the natives. An own-operation member body cannot be
// written in operators or interpolation — that sugar selects the very slot being
// defined (Constraints §6.1) — so every such member is a one-line delegation to
// one of the declarations below. The one thing above the door here is `mod`, the
// Euclidean adjustment over `rem`; there is no guard anywhere in this file,
// because float partiality is `NaN` rather than a throw.
//
// `Num<Float>`'s `fromNat` is absent from this block on purpose: it composes out
// of two slots that already exist beneath it — `Signed.fromInt` over
// `Int.fromNat`, each piece exact, total, and a different slot than the one
// being defined — and the strictly-simpler doctrine sends such a body to
// ordinary Hexagon (`spec/intrinsics.md` §3.2). The conversion is reached
// through its declaring module because the dot cannot reach it: `fromInt`'s
// subject appears only in its result, so there is no receiver to stand left of
// a dot. The `Signed` block is written above the `Num` block anyway, so a
// reader meets the composition's pieces in the order it uses them.
// `floatFromInt` *does* cross: any Hexagon body for `Int` -> `Float`
// typechecks only through Numeric Literals §5.1's contextual widening, which
// elaborates through `Signed<Float>`'s `fromInt`, the very slot being defined.
extern from "hex:intrinsic"
    fun floatAdd as nativeAdd(left: Float, right: Float): Float
    fun floatMultiply as nativeMultiply(left: Float, right: Float): Float
    fun floatSubtract as nativeSubtract(left: Float, right: Float): Float
    fun floatNegate as nativeNegate(value: Float): Float
    fun floatFromInt as nativeFromInt(value: Int): Float
    fun floatDivide as nativeDivide(left: Float, right: Float): Float
    fun floatEquals as nativeEquals(left: Float, right: Float): Bool
    fun floatCompare as nativeCompare(left: Float, right: Float): Ordering
    fun floatShow as nativeShow(value: Float): String
    fun floatPow as nativePow(value: Float, exponent: Float): Float
    fun floatHash as nativeHash(value: Float): Int

    (** The truncated remainder of `left` divided by `right`, taking the sign of
        `left` — this is JS's `%`, and C's `fmod`. It is exact: the true
        remainder of two floats is always a float, so nothing rounds. It never
        throws; a zero divisor or a non-finite operand answers `NaN`, exactly as
        float division does. *)
    export fun floatRem as rem(left: Float, right: Float): Float

honor Eq<Float> =
    (** Whether `left` and `right` are the same float, by SameValueZero: `NaN`
        equals itself and `-0.0` equals `0.0`. This is deliberately not the
        host's `===`, so that a float can key a hash table. *)
    equals(left, right) = nativeEquals(left, right)

honor Ord<Float> =
    (** How `left` orders against `right`: a total order, so every float has a
        place. `NaN` sorts last, after `+Infinity`, and `-0.0` compares equal to
        `0.0`. *)
    compare(left, right) = nativeCompare(left, right)

honor Show<Float> =
    (** The host's decimal form of `value`, warts and all: `4.0` shows as `4`,
        `-0.0` as `0`, and the non-finite floats as `NaN`, `Infinity`, and
        `-Infinity`. *)
    show(value) = nativeShow(value)

honor Hash<Float> =
    (** A hash of `value`, normalized to agree with `Eq` above: every `NaN`
        hashes alike, and `-0.0` hashes as `0.0`. *)
    hash(value) = nativeHash(value)

honor Signed<Float> =
    (** The difference of `left` and `right`, rounded to the nearest float. *)
    subtract(left, right) = nativeSubtract(left, right)
    (** The additive inverse of `value`. Total, and it does distinguish the
        zeroes: negating `0.0` gives `-0.0`. *)
    negate(value) = nativeNegate(value)
    (** The integer `value` as a `Float`. Total and exact: the range an `Int`
        holds is exactly the range a float holds without rounding. *)
    fromInt(value) = nativeFromInt(value)

honor Num<Float> =
    (** The sum of `left` and `right`, rounded to the nearest float. *)
    add(left, right) = nativeAdd(left, right)
    (** The product of `left` and `right`, rounded to the nearest float. *)
    multiply(left, right) = nativeMultiply(left, right)
    (** The natural number `value` as a `Float`, through the two conversions
        beneath it: every `Nat` is an `Int`, and every `Int` is a `Float`. *)
    fromNat(value) = Signed.fromInt(Int.fromNat(value))

honor Frac<Float> =
    (** `left` divided by `right`, following IEEE 754. It never throws: a zero
        divisor answers an infinity, or `NaN` when the dividend is zero too. *)
    divide(left, right) = nativeDivide(left, right)

(** `value` raised to the power `exponent` — the analytic power, `exp(exponent *
    ln value)`. Total and honestly IEEE, `NaN` edges and all: `Float.pow(2.0,
    0.5)` is the nearest float to the square root of two, and every `Int`
    exponent has an answer too, negative ones included, so the guard the integer
    types carry does not exist here. The operator `**` takes an `Int` exponent;
    this door is where a fractional one belongs. *)
widens Pow.pow(value: Float, exponent: Float): Float = nativePow(value, exponent)

honor Pow<Float> =
    pow = widened

(** The Euclidean remainder of `left` divided by `right`: never negative,
    whatever the signs — which is what angle wrapping, phase accumulation, and
    hue rotation want. It never throws, answering `NaN` wherever `rem` does. One
    honest caveat at this type: the adjustment that lifts a negative remainder
    can round up to the magnitude of `right` itself when the remainder is tiny
    and the divisor is large, so the bound is `0.0 <= result <= abs(right)`
    rather than the strict one `Int.mod` keeps. *)
export let mod(left: Float, right: Float): Float =
    // Bare, not `left.rem(right)`: `rem` is this module's own export, and a
    // prelude module cannot see itself — the dot would look for `Float`'s
    // companion, which is this file, and find nothing. This is a non-case of
    // the stdlib dot rule (`stdlib-roadmap.md` §1).
    let remainder = rem(left, right)
    if remainder < 0.0 then
        remainder + (if right < 0.0 then -right else right)
    else
        remainder

(** Positive infinity — what every overflow saturates to, and what a positive
    float divided by zero answers. There is no literal for it, so this is the
    spelling: negate it for the other one, `-Float.infinity`. *)
export let infinity: Float = 1.0 / 0.0

(** The not-a-number float — the answer every partial float operation gives in
    place of throwing, since nothing in this module guards. Test for it with
    `Float.isNan` and never with `x != x`: `Eq<Float>` is SameValueZero, so a
    `NaN` here equals itself and the C idiom is uniformly `False`. *)
export let nan: Float = 0.0 / 0.0

(** Whether `value` is the not-a-number float. This is `value == Float.nan`,
    which works for exactly the reason the imported `x != x` idiom does not:
    `Eq<Float>` is SameValueZero, so `NaN` compares equal to itself. *)
export let isNan(value: Float): Bool = value == nan

(** Whether `value` is an ordinary float — neither infinite nor `NaN`. Both
    zeroes and every subnormal are finite. *)
export let isFinite(value: Float): Bool =
    value != infinity and value != -infinity and not isNan(value)
