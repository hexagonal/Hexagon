// Prelude nominals that are implicitly in scope in every Hexagon module.
//
// This file is the canonical, human-facing source of the prelude. The compiler
// embeds an identical copy in `compiler/src/prelude.ts` so that `compileProject`
// stays filesystem-free; a test asserts the two never drift.
export union Ordering derives (Eq, Show) =
    | Less
    | Equal
    | Greater
