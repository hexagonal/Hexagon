module Prelude

(** Evaluates its argument and discards the result, returning `()`. *)
export let ignore(value: a): Unit = ()

(** Thrown by `assume` when the code it guards fails after all: the writer's
    word that it could not, broken. `cause` is the failure that broke it — an
    exception, or the raw value JavaScript threw — and it is JavaScript's own
    `Error.cause`, so an uncaught `AssumptionFault` prints the cause's message
    and a debugger shows the chain. *)
export fault AssumptionFault(cause: Exn)
