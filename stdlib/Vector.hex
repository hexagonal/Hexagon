// The public Vector companion over the compiler's representation core.

export exception IndexError(index: Int, size: Int)
export exception SliceError(start: Int, end: Int)

// The whole boundary Collections Part 3 section 7 pins: representation-sensitive
// length and end updates, signed indexed access, persistent indexed update, and
// the eager/lazy bridge. Everything below is ordinary Hexagon over these.
extern from "hex:intrinsic"
    export fun vectorLength as length<a>(values: Vector(a)): Int
    export fun vectorAppend as append<a>(values: Vector(a), value: a): Vector(a)
    export fun vectorPrepend as prepend<a>(values: Vector(a), value: a): Vector(a)
    export fun vectorAt as at<a>(values: Vector(a), index: Int): a
    export fun vectorSet as set<a>(values: Vector(a), index: Int, value: a): Vector(a)
    export fun vectorToSeq as toSeq<a>(values: Vector(a)): Seq(a)
    // Eager by design: converting an infinite Seq does not terminate.
    export fun vectorFromSeq as fromSeq<a>(values: Seq(a)): Vector(a)

export let empty: Vector(a) = []

export fun singleton<a>(value: a): Vector(a) = [value]

export fun isEmpty<a>(values: Vector(a)): Bool = length(values) == 0

export fun first<a>(values: Vector(a)): Option(a) = match values
    [] => None
    [value, ...] => Some(value)

export fun last<a>(values: Vector(a)): Option(a) = match values
    [] => None
    [..., value] => Some(value)

export fun dropFirst<a>(values: Vector(a)): Vector(a) = match values
    [] => []
    [_, ...rest] => rest

export fun dropLast<a>(values: Vector(a)): Vector(a) = match values
    [] => []
    [...rest, _] => rest

export fun get<a>(values: Vector(a), index: Int): Option(a) =
    if index < 1 or index > length(values) then
        None
    else
        Some(values[index])
