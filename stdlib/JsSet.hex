module JsSet

// The public companion of the captured foreign `JsSet(a)` (FFI Part 10), and
// the module that declares it.
//
// The type row declares `JsSet` itself (`spec/intrinsics.md` section 3.3), as
// `JsMap.hex`'s declares `JsMap`. Its values are native `Set` objects, so the
// row names no representation and writes no variance claim: `JsSet(a)` is
// invariant.
//
// Everything here reads a native `Set` that Hexagon holds as its own copy, made
// as the foreign set crossed (section 2), or builds one fresh from a sequence
// (section 6.5). There is no mutation surface and there will not be one
// (section 1), and **no `Hash`**: membership is the native
// set's own SameValueZero equality, reference identity for objects, not
// Hexagon's structural one (section 4.3).
//
// A set has no brackets and no `get`, permanently and with reasons recorded
// (section 5): brackets retrieve a payload selected by a position or a key, and
// a set's elements *are* its keys with nothing further to retrieve. Membership
// is `contains` and there is no second Boolean read.

extern from "hex:intrinsic"
    (** A JavaScript `Set` Hexagon holds as its own copy, captured as a foreign
        set crossed or built fresh. No foreign code can reach the copy and
        Hexagon has no way to change it, so it never changes. Elements are compared by
        JavaScript's own equality, not by `Hash`. *)
    export type jsSet as JsSet(a)

    (** How many elements `s` holds: the captured set's own `size`, which is
        the source's size at the moment of capture and never changes. A read of
        a value, which the compiler may share or hoist freely (section 2). *)
    export fun jsSetSize as size(s: JsSet(a)) -> Int

    (** Whether `s` holds `element`, by the native `has` and its equality. The
        only Boolean read a set has, and the membership spelling (section 5).
        The set is a genuine native `Set` that Hexagon holds, so the read cannot
        throw: a hostile or proxied source throws at the crossing that captured
        it, an ordinary foreign throw arriving as `JsError` (section 4.4). *)
    export fun jsSetHas as contains(s: JsSet(a), element: a) -> Bool

    (** The elements of `elements` collected into a **fresh** native `Set`,
        eagerly and in traversal order. Unconstrained and shallow: nothing is
        hashed, decoded, or copied element-wise, so the result is returned
        directly rather than as a `Result`. Duplicates behave as native
        construction does — the set keeps the first representative it stored and
        that element's position. Each call builds a new collection and consumes
        its source once, so an infinite sequence does not terminate. *)
    export fun jsSetFromSeq as fromSeq(elements: Seq(a)) -> JsSet(a)

    // Unexported, beneath the `Iterable` instance at the end of the file
    // (section 6.1's row), and the whole of the set's traversal: `toSeq` is the
    // instance's member, reached as the dot call `s.toSeq()` and as
    // `JsSet.toSeq(s)` qualified, and never bound as a plain export too — a
    // module-level binding of a member's spelling beside the instance is the
    // Constraints section 4.6 rebinding error. The walk is the native `Set`
    // iterator's, in the captured set's insertion order, lazy and allocating no
    // second copy; it may be forced at any time and observes the same
    // elements, because the set cannot change (section 6.3). Hexagon has no
    // other way to walk a native set, which is why it is a door row. Unlike
    // `JsMap`, there is no second name for it — the persistent `Set` has no
    // `elements` export to mirror.
    fun jsSetToSeq as nativeToSeq(s: JsSet(a)) -> Seq(a)

honor Iterable<JsSet(a)> =
    type Item = a
    toSeq(s) = nativeToSeq(s)
