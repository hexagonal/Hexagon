module Runtime.Regex

import Regex.Syntax as Syntax

// The regular-expression engine (`spec/regex.md` §6) — the RE2-shaped matcher
// that `Hex.Regex`'s two sealed rows reach through the intrinsic door. This is a
// runtime-internal module in `Hex.Runtime.HashTrie`'s exact sense: it is
// compiled only as a privileged runtime module, it exports nothing at the
// Hexagon level, and the emitted JavaScript is what carries anything out, under
// an export list the emitter writes. No Hexagon module can import this one, by
// name or by accident, however the compiler happens to place the file.
//
// **What is here now** (#927, implementation arcs 1, 3a and 3b): the storage,
// the Unicode tables and the subject reads, program construction (§6.1), and the
// search as a Pike VM (§6.2). The lazy DFA that runs in front of the VM lands in
// the arc's next step; the sealed rows that hand a `Compiled` back and forth
// land with the surface.
//
// **The seat.** This module has no `precedes`: no prelude member names it, and
// it imports a library member, `Regex.Syntax`, for the tree it compiles and the
// `PropertyKind` its table row is keyed by (§6.1, §7). So it is ordered with the
// library members, after the one it imports (`runtime-modules.ts`), with the
// whole prelude's arithmetic and collections beneath it. The emitted `Regex.js`
// is reached only from `Regex.hex`'s own emitted door rows, which sit later
// still.
//
// **The storage is confined.** A `Buffer(a)` is addressable from this module and
// nowhere else (`spec/intrinsics.md` §3.3): it may not appear in an exported
// signature, in an exported pattern's parameter types, in an exception payload,
// in the representation of a non-`opaque` exported type, or in an `export` of
// its own, and the checker verifies all of that. It is the half of Effects §6.2
// species (d) the compiler can check — the other half being the engine's own
// obligation never to write a program it has frozen.

// The mutable storage every structure in the engine is built over (§6.3): DFA
// state tables, the alphabet map, the VM's thread lists, the capture vectors.
//
// It is a `type` row rather than a declared form because no declared form can
// spell it honestly — a Hexagon record is immutable whatever its fields
// (Statements §6.4), so none can carry the mutation, and an empty `opaque
// record` would leave the compiler nothing to own.
//
// **The arrows are the honest ones** (§3.3, `regex.md` §7). `create`, `read` and
// `write` are `->~`, impure and unable to fail: a fresh buffer's identity is
// observable through the other two, a write to one and a read of the other
// telling two buffers apart, and none of them throws anything but a fault.
// `length` is `->`, because a buffer's size is fixed at creation and no row
// changes it, so that read is a read of a value.
//
// **Bounds are unchecked.** The engine never reads or writes outside a buffer it
// sized, and that is a conformance obligation on the engine, not a check — which
// is what keeps the scan step's cost where §6.4's bounds put it.
extern from "hex:intrinsic"
    type buffer as Buffer(a)

    // A fresh buffer of `size` slots, every one holding `fill`. The fill is
    // required: there is no hole to read back, so every index of a buffer this
    // row answered is a value from the moment it exists.
    fun bufferCreate as create(size: Int, fill: a) ->~ Buffer(a)

    // The slot at `index`, zero-based.
    fun bufferRead as read(buffer: Buffer(a), index: Int) ->~ a

    // Stores `value` at `index`, zero-based.
    fun bufferWrite as write(buffer: Buffer(a), index: Int, value: a) ->~ Unit

    // The slot count the buffer was created with.
    fun bufferLength as length(buffer: Buffer(a)) -> Int

    // A property's codepoints as sorted, disjoint, inclusive ranges, keyed by
    // the tree's own kind and canonical value (§7). The tables are Unicode
    // 17.0.0's, kept in one place and referenced by name, never inlined into an
    // emitted program. Every property's ranges exclude U+D800–U+DFFF, so no
    // `\p{…}` naming a property matches a lone surrogate; `Any` alone answers
    // U+0000–U+10FFFF whole. An unknown name is unreachable, the parser having
    // closed the set, and answers the empty vector rather than a fault. A `->`
    // read of a fixed table.
    fun regexPropertyRanges as propertyRanges(kind: Syntax.PropertyKind, value: String) -> Vector((Int, Int))

    // Every codepoint whose simple case folding equals `point`'s, `point`
    // included, ascending: the closure a folded class needs (§3.4). A `->` read
    // of a fixed table.
    fun regexFoldOrbit as foldOrbit(point: Int) -> Vector(Int)

    // The subject, read by code unit (§6.2, §6.4). The public `String` surface
    // reads by codepoint position, walking from the start each time, and gives
    // no value for a lone surrogate; the engine reads the subject once, forward,
    // and cuts each group's text from the offsets the scan has in hand. All
    // three are `->` reads of a value.
    //
    // The codepoint whose first code unit is at `offset`, zero-based: a
    // well-formed pair is one codepoint, a lone surrogate is itself (§3.6).
    fun regexCodepointAt as codepointAt(text: String, offset: Int) -> Int

    // The subject's length in code units.
    fun regexCodeUnits as codeUnits(text: String) -> Int

    // The text between two code-unit offsets, `from` included, `to` not.
    fun regexCut as cut(text: String, from: Int, to: Int) -> String

// ---------------------------------------------------------------------------
// Codepoint sets (§6.1)
//
// A set is a vector of sorted, disjoint, inclusive ranges, never adjacent: the
// shape the property row answers and every operation below keeps.

let lastPoint: Int = 1_114_111

// The union of two sets, in one pass over both.
let unionOf(left: Vector((Int, Int)), right: Vector((Int, Int))): Vector((Int, Int)) =
    let leftSize = Vector.length(left)
    let rightSize = Vector.length(right)
    var result: Vector((Int, Int)) = []
    var leftAt = 1
    var rightAt = 1
    while leftAt <= leftSize or rightAt <= rightSize
        let takeLeft = rightAt > rightSize or (leftAt <= leftSize and left[leftAt].item1 <= right[rightAt].item1)
        let (low, high) = if takeLeft then left[leftAt] else right[rightAt]
        if takeLeft then leftAt := leftAt + 1 else rightAt := rightAt + 1
        let count = Vector.length(result)
        if count > 0 and low <= result[count].item2 + 1 then
            if high > result[count].item2 then result := Vector.set(result, count, (result[count].item1, high))
        else
            result := result.append((low, high))
    result

// Every codepoint not in `set`, over U+0000–U+10FFFF.
let complementOf(set: Vector((Int, Int))): Vector((Int, Int)) =
    var result: Vector((Int, Int)) = []
    var next = 0
    for (low, high) in set
        if low > next then result := result.append((next, low - 1))
        next := high + 1
    if next <= lastPoint then result.append((next, lastPoint)) else result

// Whether `point` is in `set`, by binary search.
let contains(set: Vector((Int, Int)), point: Int): Bool =
    var low = 1
    var high = Vector.length(set)
    var found = False
    while not found and low <= high
        let middle = Int.div(low + high, 2)
        let (from, to) = set[middle]
        if point < from then
            high := middle - 1
        else if point > to then
            low := middle + 1
        else
            found := True
    found

// `points` in ascending order, by merge sort.
fun sortedPoints(points: Vector(Int)): Vector(Int) =
    let count = Vector.length(points)
    if count <= 1 then
        points
    else
        let half = Int.div(count, 2)
        let left = sortedPoints(points[1..half])
        let right = sortedPoints(points[half + 1..count])
        var merged: Vector(Int) = []
        var leftAt = 1
        var rightAt = 1
        while leftAt <= half or rightAt <= count - half
            if rightAt > count - half or (leftAt <= half and left[leftAt] <= right[rightAt]) then
                merged := merged.append(left[leftAt])
                leftAt := leftAt + 1
            else
                merged := merged.append(right[rightAt])
                rightAt := rightAt + 1
        merged

// `points`, in any order, as a set.
let setOfPoints(points: Vector(Int)): Vector((Int, Int)) =
    var result: Vector((Int, Int)) = []
    for point in sortedPoints(points)
        let count = Vector.length(result)
        if count > 0 and point <= result[count].item2 + 1 then
            if point > result[count].item2 then result := Vector.set(result, count, (result[count].item1, point))
        else
            result := result.append((point, point))
    result

// `set` closed under simple case folding (§3.4): every codepoint whose folding
// equals a member's. The points a member's orbit adds are few beside the set,
// so they are gathered first and merged once.
let foldedSet(set: Vector((Int, Int))): Vector((Int, Int)) =
    var added: Vector(Int) = []
    for (low, high) in set
        var point = low
        while point <= high
            let orbit = foldOrbit(point)
            if Vector.length(orbit) > 1 then
                for other in orbit
                    if not contains(set, other) then added := added.append(other)
            point := point + 1
    unionOf(set, setOfPoints(added))

// The codepoints one class item stands for.
let itemSet(item: Syntax.ClassItem): Vector((Int, Int)) = match item
    Syntax.Range(low, high) => [(low, high)]
    Syntax.Property(kind, value, negated) =>
        let ranges = propertyRanges(kind, value)
        if negated then complementOf(ranges) else ranges

// A class's codepoints, in §6.1's order: each item resolved and complemented
// where it is negated, the union taken, folded where the class is folded, and
// complemented where the class is negated. Fold before complement is what makes
// `(?i)[^a]` not match `A`.
let classSet(items: Vector(Syntax.ClassItem), negated: Bool, folded: Bool): Vector((Int, Int)) =
    var set: Vector((Int, Int)) = []
    for item in items
        set := unionOf(set, itemSet(item))
    let closed = if folded then foldedSet(set) else set
    if negated then complementOf(closed) else closed

// ---------------------------------------------------------------------------
// The NFA (§6.1)
//
// One Thompson construction over the tree. An instruction is an operation and
// two operands, at a zero-based program counter:
//
//  - `consume c`: one codepoint in class `c`, then the next instruction;
//  - `split x y`: both, `x` first in priority (§3.2);
//  - `jump x`;
//  - `save s`: the position into capture slot `s` (group `g` is slots `2g`
//    and `2g + 1`);
//  - `assert a`: an assertion (`anchorCode`), consuming nothing;
//  - `match`.
//
// The construction is pure: it builds vectors, which `compile` then freezes
// into buffers.

let opMatch: Int = 0
let opConsume: Int = 1
let opSplit: Int = 2
let opJump: Int = 3
let opSave: Int = 4
let opAssert: Int = 5

record ClassSpec = { items: Vector(Syntax.ClassItem), negated: Bool, folded: Bool }

record Code = {
    ops: Vector(Int),
    first: Vector(Int),
    second: Vector(Int),
    classes: Vector(ClassSpec),
}

let anchorCode(kind: Syntax.AnchorKind): Int = match kind
    Syntax.TextStart => 0
    Syntax.TextEnd => 1
    Syntax.LineStart => 2
    Syntax.LineEnd => 3
    Syntax.WordBoundary => 4
    Syntax.NotWordBoundary => 5

let counter(code: Code): Int = Vector.length(code.ops)

let emit(code: Code, op: Int, first: Int, second: Int): Code =
    { code with ops = code.ops.append(op), first = code.first.append(first), second = code.second.append(second) }

let setFirst(code: Code, at: Int, target: Int): Code = { code with first = Vector.set(code.first, at + 1, target) }

let setSecond(code: Code, at: Int, target: Int): Code = { code with second = Vector.set(code.second, at + 1, target) }

let kindCode(kind: Syntax.PropertyKind): Int = match kind
    Syntax.GeneralCategory => 0
    Syntax.Script => 1
    Syntax.ScriptExtensions => 2
    Syntax.Binary => 3
    Syntax.Any => 4
    Syntax.Ascii => 5
    Syntax.Assigned => 6
    Syntax.Word => 7

let sameItem(left: Syntax.ClassItem, right: Syntax.ClassItem): Bool = match (left, right)
    (Syntax.Range(leftLow, leftHigh), Syntax.Range(rightLow, rightHigh)) => leftLow == rightLow and leftHigh == rightHigh
    (Syntax.Property(leftKind, leftValue, leftNegated), Syntax.Property(rightKind, rightValue, rightNegated)) =>
        kindCode(leftKind) == kindCode(rightKind) and leftValue == rightValue and leftNegated == rightNegated
    _ => False

let sameSpec(left: ClassSpec, right: ClassSpec): Bool =
    var same = left.negated == right.negated and left.folded == right.folded and
        Vector.length(left.items) == Vector.length(right.items)
    var index = 1
    while same and index <= Vector.length(left.items)
        same := sameItem(left.items[index], right.items[index])
        index := index + 1
    same

// A `consume` of `spec`'s class. A class the program already holds is reused,
// so that a counted repetition's copies, and every repeated literal, resolve
// once (§6.4: a folded `\p{L}` costs its membership once).
let emitClass(code: Code, spec: ClassSpec): Code =
    var found = -1
    var index = 1
    while found < 0 and index <= Vector.length(code.classes)
        if sameSpec(code.classes[index], spec) then found := index - 1
        index := index + 1
    if found >= 0 then
        emit(code, opConsume, found, 0)
    else
        emit({ code with classes = code.classes.append(spec) }, opConsume, Vector.length(code.classes), 0)

let singleClass(point: Int): ClassSpec = ClassSpec({ items = [Syntax.Range(point, point)], negated = False, folded = False })

// A `split` at `at` whose preferred branch is the next instruction and whose
// other is `out` — or the other way round where the repetition is lazy.
let setSplit(code: Code, at: Int, out: Int, greedy: Bool): Code =
    if greedy then setSecond(setFirst(code, at, at + 1), at, out) else setSecond(setFirst(code, at, out), at, at + 1)

// Whether `expr` can match the empty string.
fun nullable(expr: Syntax.Expr): Bool = match expr
    Syntax.Empty => True
    Syntax.Literal(_) => False
    Syntax.Dot(_) => False
    Syntax.Class(_, _, _) => False
    Syntax.Anchor(_) => True
    Syntax.Concat(parts) =>
        var all = True
        for part in parts
            all := all and nullable(part)
        all
    Syntax.Alternate(branches) =>
        var any = False
        for branch in branches
            any := any or nullable(branch)
        any
    Syntax.Repeat(body, min, _, _) => min == 0 or nullable(body)
    Syntax.Capture(body, _, _) => nullable(body)

fun emitExpr(code: Code, expr: Syntax.Expr): Code = match expr
    Syntax.Empty => code
    Syntax.Literal(point) => emitClass(code, singleClass(point))
    Syntax.Dot(newline) =>
        if newline then
            emitClass(code, ClassSpec({ items = [Syntax.Range(0, lastPoint)], negated = False, folded = False }))
        else
            emitClass(code, ClassSpec({ items = [Syntax.Range(10, 10)], negated = True, folded = False }))
    Syntax.Class(items, negated, folded) =>
        emitClass(code, ClassSpec({ items = items, negated = negated, folded = folded }))
    Syntax.Anchor(kind) => emit(code, opAssert, anchorCode(kind), 0)
    Syntax.Concat(parts) =>
        var current = code
        for part in parts
            current := emitExpr(current, part)
        current
    Syntax.Alternate(branches) =>
        // Each branch but the last behind a split preferring it, each ending
        // in a jump past the rest.
        var current = code
        var jumps: Vector(Int) = []
        let count = Vector.length(branches)
        var index = 1
        while index < count
            let split = counter(current)
            current := emitExpr(emit(current, opSplit, split + 1, 0), branches[index])
            jumps := jumps.append(counter(current))
            current := emit(current, opJump, 0, 0)
            current := setSecond(current, split, counter(current))
            index := index + 1
        current := emitExpr(current, branches[count])
        let end = counter(current)
        for jump in jumps
            current := setFirst(current, jump, end)
        current
    Syntax.Repeat(body, min, max, greedy) =>
        var current = code
        var copies = 0
        while copies < min
            current := emitExpr(current, body)
            copies := copies + 1
        match max
            None =>
                if nullable(body) then
                    // `x*` over a body that can match empty is `(?:x+)?`, as
                    // RE2 and Go compile it (Go issue 46123): one optional
                    // entry, then a loop back that the body must reach. Read
                    // as a plain loop, the program-counter dedupe would end
                    // every path through an empty iteration, and `(|a)*` on
                    // `aa` would match `aa` where `(?:|a){0,5}` matches the
                    // empty string (§3.2).
                    let entry = counter(current)
                    let start = entry + 1
                    current := emitExpr(emit(current, opSplit, 0, 0), body)
                    let back = counter(current)
                    current := emit(current, opSplit, 0, 0)
                    let end = counter(current)
                    let looped = if greedy then setSecond(setFirst(current, back, start), back, end)
                        else setSecond(setFirst(current, back, end), back, start)
                    setSplit(looped, entry, end, greedy)
                else
                    // `x*` after the required copies: a split back over the body.
                    let loop = counter(current)
                    current := emitExpr(emit(current, opSplit, 0, 0), body)
                    current := emit(current, opJump, loop, 0)
                    setSplit(current, loop, counter(current), greedy)
            Some(most) =>
                // The optional copies nest, each split's way out the end:
                // `x{1,3}` is `x(x(x)?)?`.
                var splits: Vector(Int) = []
                while copies < most
                    splits := splits.append(counter(current))
                    current := emitExpr(emit(current, opSplit, 0, 0), body)
                    copies := copies + 1
                let end = counter(current)
                for split in splits
                    current := setSplit(current, split, end, greedy)
                current
    Syntax.Capture(body, index, _) =>
        let opened = emitExpr(emit(code, opSave, 2 * index, 0), body)
        emit(opened, opSave, 2 * index + 1, 0)

// The whole pattern's program: group 0 saved around the tree, then `match`.
let codeOf(pattern: Syntax.Pattern): Code =
    let empty = Code({ ops = [], first = [], second = [], classes = [] })
    let body = emitExpr(emit(empty, opSave, 0, 0), pattern.root)
    emit(emit(body, opSave, 1, 0), opMatch, 0, 0)

// ---------------------------------------------------------------------------
// The compiled program (§6.1, §6.3)
//
// The program a `Regex` carries: the instructions, frozen into buffers that no
// row writes after `compile` returns, and the classes by their tree items, with
// the one memo resolution fills on first use (§6.2's second transparent memo).
record Compiled = {
    ops: Buffer(Int),
    first: Buffer(Int),
    second: Buffer(Int),
    size: Int,
    classes: Vector(ClassSpec),
    resolved: Buffer(Option(Vector((Int, Int)))),
    groupCount: Int,
}

let frozen(values: Vector(Int)): Buffer(Int) =
    let buffer = create~(Vector.length(values), 0)
    var index = 0
    for value in values
        write~(buffer, index, value)
        index := index + 1
    buffer

// The program for `pattern`. It reads no table: class resolution waits for the
// program's first use (§6.1), so a program emitted as a constant carries its
// properties by name.
let compile(pattern: Syntax.Pattern): Compiled =
    let code = codeOf(pattern)
    Compiled({
        ops = frozen~(code.ops),
        first = frozen~(code.first),
        second = frozen~(code.second),
        size = Vector.length(code.ops),
        classes = code.classes,
        resolved = create~(Vector.length(code.classes), None),
        groupCount = pattern.groupCount,
    })

// Class `index`'s codepoints, resolved once and kept in the program.
let classOf(program: Compiled, index: Int): Vector((Int, Int)) =
    match read~(program.resolved, index)
        Some(set) => set
        None =>
            let spec = program.classes[index + 1]
            let set = classSet(spec.items, spec.negated, spec.folded)
            write~(program.resolved, index, Some(set))
            set

// ---------------------------------------------------------------------------
// The search: a Pike VM (§6.2)
//
// The NFA simulated over the subject one codepoint at a time, each thread
// carrying its own capture slots, the threads kept in priority order so that
// the first to reach `match` is the leftmost-first match (§3.2). Linear in the
// subject times the program, whatever the pattern. The lazy DFA of §6.2 runs in
// front of it in a later step and answers the same matches.
//
// A thread's slots hold, for each capture slot, the codepoint position and the
// code-unit offset it saved, both -1 until saved.

record Thread = { pc: Int, slots: Vector(Int) }

// Where the scan stands: the position and code-unit offset of the next
// codepoint, and the codepoints on either side, -1 at the text's edges.
record Place = { position: Int, offset: Int, before: Int, after: Int }

let width(point: Int): Int = if point > 65_535 then 2 else 1

let isWord(point: Int): Bool = point >= 0 and contains(propertyRanges(Syntax.Word, ""), point)

let holds(kind: Int, place: Place): Bool =
    if kind == 0 then
        place.position == 1
    else if kind == 1 then
        place.after < 0
    else if kind == 2 then
        place.position == 1 or place.before == 10
    else if kind == 3 then
        place.after < 0 or place.after == 10
    else if kind == 4 then
        isWord(place.before) != isWord(place.after)
    else
        isWord(place.before) == isWord(place.after)

let saved(slots: Vector(Int), slot: Int, place: Place): Vector(Int) =
    Vector.set(Vector.set(slots, 2 * slot + 1, place.position), 2 * slot + 2, place.offset)

// `list` with the threads `start` reaches through the instructions that consume
// nothing, in priority order: a `split`'s first branch is followed before its
// second. A program counter already reached at this place (`mark` holding
// `stamp`) is not reached again, which is what keeps an empty iteration from
// being taken twice and the list no longer than the program.
let follow(program: Compiled, mark: Buffer(Int), stamp: Int, start: Thread, list: Vector(Thread), place: Place): Vector(Thread) =
    var pending: Vector(Thread) = [start]
    var reached = list
    while Vector.length(pending) > 0
        let thread = pending[Vector.length(pending)]
        pending := Vector.dropLast(pending)
        let pc = thread.pc
        if read~(mark, pc) != stamp then
            write~(mark, pc, stamp)
            let op = read~(program.ops, pc)
            if op == opJump then
                pending := pending.append({ thread with pc = read~(program.first, pc) })
            else if op == opSplit then
                pending := pending
                    .append({ thread with pc = read~(program.second, pc) })
                    .append({ thread with pc = read~(program.first, pc) })
            else if op == opSave then
                pending := pending.append(Thread({ pc = pc + 1, slots = saved(thread.slots, read~(program.first, pc), place) }))
            else if op == opAssert then
                if holds(read~(program.first, pc), place) then pending := pending.append({ thread with pc = pc + 1 })
            else
                reached := reached.append(thread)
    reached

// The codepoint before `offset`, -1 at the start: one code unit back, or two
// where those two are a well-formed pair.
let pointBefore(text: String, offset: Int): Int =
    if offset == 0 then
        -1
    else if offset >= 2 and codepointAt(text, offset - 2) > 65_535 then
        codepointAt(text, offset - 2)
    else
        codepointAt(text, offset - 1)

let placeAt(text: String, units: Int, position: Int, offset: Int): Place =
    Place({
        position = position,
        offset = offset,
        before = pointBefore(text, offset),
        after = if offset < units then codepointAt(text, offset) else -1,
    })

let isNone(value: Option(a)): Bool = match value
    Some(_) => False
    None => True

let isSome(value: Option(a)): Bool = not isNone(value)

// Every capture slot unsaved: a position and an offset of -1 for each.
let unsaved(groupCount: Int): Vector(Int) =
    var slots: Vector(Int) = []
    while Vector.length(slots) < 4 * (groupCount + 1)
        slots := slots.append(-1)
    slots

// Each group's span and text from a match's slots: `None` for a group the match
// never entered (§3.3).
let groupsOf(text: String, groupCount: Int, slots: Vector(Int)): Vector(Option((Int, Int, String))) =
    var groups: Vector(Option((Int, Int, String))) = []
    var group = 0
    while group <= groupCount
        let startPosition = slots[4 * group + 1]
        let startOffset = slots[4 * group + 2]
        let endPosition = slots[4 * group + 3]
        let endOffset = slots[4 * group + 4]
        groups := groups.append(if startPosition < 0 or endPosition < 0 then
            None
        else
            Some((startPosition, endPosition - startPosition, cut(text, startOffset, endOffset))))
        group := group + 1
    groups

// The leftmost-first match at or after position `start`, with the cursor the
// next search resumes from (§6.2): every group when `spans` is set, and with it
// clear only whether there is one, the given cursor echoed.
let search(
    program: Compiled,
    text: String,
    start: Int,
    cursor: (Int, Int),
    spans: Bool,
): Option((Vector(Option((Int, Int, String))), (Int, Int))) =
    let units = codeUnits(text)
    let (cursorPosition, cursorOffset) = cursor
    let fromCursor = cursorPosition >= 1 and cursorPosition <= start
    var position = if fromCursor then cursorPosition else 1
    var offset = if fromCursor then cursorOffset else 0
    while position < start and offset < units
        offset := offset + width(codepointAt(text, offset))
        position := position + 1
    if position < start then
        None
    else
        let mark = create~(program.size, -1)
        let fresh = Thread({ pc = 0, slots = unsaved(program.groupCount) })
        var place = placeAt(text, units, position, offset)
        var stamp = 0
        var threads: Vector(Thread) = []
        var found: Option(Vector(Int)) = None
        var running = True
        while running
            if isNone(found) then threads := follow~(program, mark, stamp, fresh, threads, place)
            let point = place.after
            let nextPlace = if point < 0 then place else placeAt(text, units, place.position + 1, place.offset + width(point))
            stamp := stamp + 1
            var next: Vector(Thread) = []
            var stepping = True
            var index = 1
            while stepping and index <= Vector.length(threads)
                let thread = threads[index]
                let op = read~(program.ops, thread.pc)
                if op == opMatch then
                    found := Some(thread.slots)
                    stepping := False
                else if point >= 0 and contains(classOf~(program, read~(program.first, thread.pc)), point) then
                    next := follow~(program, mark, stamp, { thread with pc = thread.pc + 1 }, next, nextPlace)
                index := index + 1
            threads := next
            if not spans and isSome(found) then
                running := False
            else if point < 0 or (Vector.length(threads) == 0 and isSome(found)) then
                running := False
            else
                place := nextPlace
        match found
            None => None
            Some(slots) =>
                if not spans then
                    Some(([], cursor))
                else
                    Some((groupsOf(text, program.groupCount, slots), (slots[3], slots[4])))
