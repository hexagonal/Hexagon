// `Option`, `Some`, and `None` are implicitly in scope via the prelude.

// A lazy, immutable, possibly infinite sequence of `a`s. Constructing a
// combinator computes nothing; each element is produced on demand by `next`.
export opaque record Seq(a) = { pull: () -> Option((a, Seq(a))) }

// Computes each element of `source` at most once however often the result is
// traversed, at the cost of retaining what has been produced.
extern from "hex:intrinsic"
    export fun seqMemoize as memoize<a>(source: Seq(a)): Seq(a)

// Drives one step: the head element and the successor sequence, or `None` when
// exhausted. `source` itself is unchanged.
export let next(source: Seq(a)): Option((a, Seq(a))) = (source.pull)()

// Producers, and combinators whose step yields at most one element per pull.

export let empty: Seq(a) = Seq({ pull = () => None })

export let singleton(value: a): Seq(a) = Seq({ pull = () => Some((value, empty)) })

export let cons(value: a, rest: Seq(a)): Seq(a) = Seq({ pull = () => Some((value, rest)) })

export fun iterate(seed: a, step: a -> a): Seq(a) =
    Seq({ pull = () => Some((seed, iterate(step(seed), step))) })

export fun map(source: Seq(a), transform: a -> b): Seq(b) =
    Seq({ pull = () =>
        match next(source)
            None => None
            Some((value, rest)) => Some((transform(value), map(rest, transform)))
    })

export fun take(source: Seq(a), count: Int): Seq(a) =
    if count <= 0 then
        empty
    else
        Seq({ pull = () =>
            match next(source)
                None => None
                Some((value, rest)) => Some((value, take(rest, count - 1)))
        })

export fun takeWhile(source: Seq(a), keep: a -> Bool): Seq(a) =
    Seq({ pull = () =>
        match next(source)
            None => None
            Some((value, rest)) =>
                if keep(value) then
                    Some((value, takeWhile(rest, keep)))
                else
                    None
    })

export fun unfold(seed: b, produce: b -> Option((a, b))): Seq(a) =
    Seq({ pull = () =>
        match produce(seed)
            None => None
            Some((value, nextSeed)) => Some((value, unfold(nextSeed, produce)))
    })

export fun zipWith(left: Seq(a), right: Seq(b), combine: (a, b) -> c): Seq(c) =
    Seq({ pull = () =>
        match next(left)
            None => None
            Some((leftValue, leftRest)) =>
                match next(right)
                    None => None
                    Some((rightValue, rightRest)) =>
                        Some((combine(leftValue, rightValue), zipWith(leftRest, rightRest, combine)))
    })

export let zip(left: Seq(a), right: Seq(b)): Seq((a, b)) =
    zipWith(left, right, (leftValue, rightValue) => (leftValue, rightValue))

export fun concat(first: Seq(a), second: Seq(a)): Seq(a) =
    Seq({ pull = () =>
        match next(first)
            None => next(second)
            Some((value, rest)) => Some((value, concat(rest, second)))
    })

// Combinators whose step may consume many source elements to yield one.

export fun filter(source: Seq(a), keep: a -> Bool): Seq(a) =
    Seq({ pull = () =>
        var current = source
        var result = None
        var searching = True
        while searching
            match next(current)
                None => searching := False
                Some((value, rest)) =>
                    if keep(value) then
                        result := Some((value, filter(rest, keep)))
                        searching := False
                    else
                        current := rest
        result
    })

export let drop(source: Seq(a), count: Int): Seq(a) =
    Seq({ pull = () =>
        var current = source
        var remaining = count
        var result = None
        var running = True
        while running
            if remaining <= 0 then
                result := next(current)
                running := False
            else
                match next(current)
                    None => running := False
                    Some((_, rest)) =>
                        current := rest
                        remaining := remaining - 1
        result
    })

export let dropWhile(source: Seq(a), discard: a -> Bool): Seq(a) =
    Seq({ pull = () =>
        var current = source
        var result = None
        var searching = True
        while searching
            match next(current)
                None => searching := False
                Some((value, rest)) =>
                    if discard(value) then
                        current := rest
                    else
                        result := Some((value, rest))
                        searching := False
        result
    })

// `flatMap` with the partially consumed inner sequence carried between pulls.
fun flatMapWith(source: Seq(a), transform: a -> Seq(b), pending: Seq(b)): Seq(b) =
    Seq({ pull = () =>
        var outer = source
        var inner = pending
        var result = None
        var searching = True
        while searching
            match next(inner)
                Some((value, rest)) =>
                    result := Some((value, flatMapWith(outer, transform, rest)))
                    searching := False
                None =>
                    match next(outer)
                        None => searching := False
                        Some((outerValue, outerRest)) =>
                            outer := outerRest
                            inner := transform(outerValue)
        result
    })

export let flatMap(source: Seq(a), transform: a -> Seq(b)): Seq(b) =
    flatMapWith(source, transform, empty)

// Consumers: drive a `Seq` to a value.

export let fold(source: Seq(a), initial: b, combine: (b, a) -> b): b =
    var accumulator = initial
    var current = source
    var running = True
    while running
        match next(current)
            None => running := False
            Some((value, rest)) =>
                accumulator := combine(accumulator, value)
                current := rest
    accumulator

export let length(source: Seq(a)): Int =
    var total = 0
    var current = source
    var running = True
    while running
        match next(current)
            None => running := False
            Some((_, rest)) =>
                total := total + 1
                current := rest
    total

export let forEach(source: Seq(a), action: a -> Unit): Unit =
    var current = source
    var running = True
    while running
        match next(current)
            None => running := False
            Some((value, rest)) =>
                action(value)
                current := rest

export let find(source: Seq(a), matches: a -> Bool): Option(a) =
    var current = source
    var result = None
    var searching = True
    while searching
        match next(current)
            None => searching := False
            Some((value, rest)) =>
                if matches(value) then
                    result := Some(value)
                    searching := False
                else
                    current := rest
    result

export let any(source: Seq(a), matches: a -> Bool): Bool =
    match find(source, matches)
        None => False
        Some(_) => True

export let all(source: Seq(a), matches: a -> Bool): Bool =
    not any(source, value => not matches(value))
