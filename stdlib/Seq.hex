module Seq

{-- Thrown when working out a value needs that same value before it is ready. A
    sequence that remembers its elements, such as one made by `memoize`, throws
    it when working out an element asks the sequence for that same element.
    `JsValue.toArray` throws it when it is asked again for a value it is still
    copying. It marks a mistake in the program, of the same kind as a function
    that calls itself without end. -}
export fault ReentrancyFault

{-- A sequence of elements that are worked out one at a time, each only when it
    is asked for. So a sequence can go on without end, as
    `Seq.iterate(1, n => n * 2)` does, and functions such as `map` and `filter`
    do no work until their result is read. A sequence never changes. Each time
    it is read from the start its elements are worked out again, unless it was
    made with `memoize`. To read a sequence, use a `for` loop, or
    `Vector.fromSeq` to get every element at once. -}
opaque record Seq(+a) = { pull: () -> Option((a, Seq(a))) }

extern from "hex:intrinsic"
    {-- A new sequence that works out each element only once and remembers it,
        however many times it is read. Use it when the elements are costly to
        work out and the sequence is read more than once. Every element that has
        been read stays in memory for as long as the new sequence is in use. -}
    export fun seqMemoize as memoize(source: Seq(a)) -> Seq(a)

{-- The first element together with a sequence of the rest, or `None` when the
    sequence is empty. The sequence itself is not changed, so calling `next` on
    it again gives the same answer. Most code reads a sequence with a `for` loop
    instead. -}
export let next(source: Seq(a)): Option((a, Seq(a))) = (source.pull)()

-- Producers, and combinators whose step yields at most one element per pull.

{-- A sequence with no elements. -}
export let empty: Seq(a) = Seq({ pull = () => None })

{-- A sequence with one element, `value`. -}
export let singleton(value: a): Seq(a) = Seq({ pull = () => Some((value, empty)) })

{-- A new sequence with `value` added before the first element. -}
export let prepend(rest: Seq(a), value: a): Seq(a) = Seq({ pull = () => Some((value, rest)) })

{-- A sequence without end that starts with the value `seed` and gets each next
    element by calling the function `step` on the one before:\
    `Seq.iterate(1, n => n * 2)` produces 1, 2, 4, 8 and so on.\
    Cut it short with `take` or `takeWhile` before reading all of it, because a
    loop over the whole of it never ends. -}
export fun iterate(seed: a, step: a -> a): Seq(a) =
    Seq({ pull = () => Some((seed, iterate(step(seed), step))) })

{-- A new sequence made by calling the function `transform` on each element:\
    `[1, 2, 3].toSeq().map(n => n * 2)` produces 2, 4, 6.\
    `transform` is called when an element is read, and called again each time
    the new sequence is read from the start. Where `transform` is costly, use
    `memoize` on the result. -}
export fun map(source: Seq(a), transform: a -> b): Seq(b) =
    Seq({ pull = () =>
        match next(source)
            None => None
            Some((value, rest)) => Some((transform(value), map(rest, transform)))
    })

{-- A new sequence with only the first `count` elements, or all of them when
    there are fewer. A `count` of zero or less gives an empty sequence. -}
export fun take(source: Seq(a), count: Int): Seq(a) =
    if count <= 0 then
        empty
    else
        Seq({ pull = () =>
            match next(source)
                None => None
                Some((value, rest)) => Some((value, take(rest, count - 1)))
        })

{-- A new sequence with the elements from the start for as long as the function
    `keep` returns `True`. It ends at the first element for which `keep`
    returns `False`, and that element is left out:\
    `[1, 2, 3, 1].toSeq().takeWhile(n => n < 3)` produces 1, 2. -}
export fun takeWhile(source: Seq(a), keep: a -> Bool): Seq(a) =
    Seq({ pull = () =>
        match next(source)
            None => None
            Some((value, rest)) =>
                if keep(value) then
                    Some((value, takeWhile(rest, keep)))
                else
                    None
    })

{-- A sequence built up from the starting value `seed`. The function `produce`
    is called with `seed` and returns either `Some` of a pair, which is the
    next element and the value to call `produce` with next time, or `None` to
    end the sequence:\
    `Seq.unfold(1, n => if n > 3 then None else Some((n * 10, n + 1)))`
    produces 10, 20, 30.\
    Where each element depends only on the element before it, `iterate` is
    simpler. -}
export fun unfold(seed: b, produce: b -> Option((a, b))): Seq(a) =
    Seq({ pull = () =>
        match produce(seed)
            None => None
            Some((value, nextSeed)) => Some((value, unfold(nextSeed, produce)))
    })

{-- A new sequence made by calling the function `combine` on each element and
    the element at the same position in the sequence `right`:\
    `[1, 2, 3].toSeq().zipWith([10, 20], (a, b) => a + b)` produces 11, 22.\
    The result ends as soon as either of the two runs out. -}
export fun zipWith(left: Seq(a), right: Seq(b), combine: (a, b) -> c): Seq(c) =
    Seq({ pull = () =>
        match next(left)
            None => None
            Some((leftValue, leftRest)) =>
                match next(right)
                    None => None
                    Some((rightValue, rightRest)) =>
                        Some((combine(leftValue, rightValue), zipWith(leftRest, rightRest, combine)))
    })

{-- A new sequence that pairs each element with the element at the same
    position in the sequence `right`:\
    `[1, 2, 3].toSeq().zip(["a", "b"])` produces `(1, "a")`, `(2, "b")`.\
    The result ends as soon as either of the two runs out. -}
export let zip(left: Seq(a), right: Seq(b)): Seq((a, b)) =
    zipWith(left, right, (leftValue, rightValue) => (leftValue, rightValue))

{-- A new sequence with the elements of the sequence followed by the elements of
    the sequence `second`. Where the first has no end, the elements of `second`
    are never reached. -}
export fun concat(first: Seq(a), second: Seq(a)): Seq(a) =
    Seq({ pull = () =>
        match next(first)
            None => next(second)
            Some((value, rest)) => Some((value, concat(rest, second)))
    })

-- Combinators whose step may consume many source elements to yield one.

{-- A new sequence with only the elements for which the function `keep` returns
    `True`. Reading the next element skips ahead until `keep` accepts one. On a
    sequence that has no end, that never returns if `keep` accepts none of the
    elements still to come. -}
export fun filter(source: Seq(a), keep: a -> Bool): Seq(a) =
    Seq({ pull = () =>
        var current = source
        var result = None
        var searching = True
        while searching
            match next(current)
                None => searching := False
                Some((value, rest)) =>
                    if keep(value) then
                        result := Some((value, filter(rest, keep)))
                        searching := False
                    else
                        current := rest
        result
    })

{-- A new sequence without the first `count` elements. A sequence with fewer
    elements than that gives an empty one. -}
export let drop(source: Seq(a), count: Int): Seq(a) =
    Seq({ pull = () =>
        var current = source
        var remaining = count
        var result = None
        var running = True
        while running
            if remaining <= 0 then
                result := next(current)
                running := False
            else
                match next(current)
                    None => running := False
                    Some((_, rest)) =>
                        current := rest
                        remaining := remaining - 1
        result
    })

{-- A new sequence that leaves out the elements from the start for as long as
    the function `discard` returns `True`. It begins with the first element for
    which `discard` returns `False` and keeps everything after it:\
    `[1, 2, 3, 1].toSeq().dropWhile(n => n < 3)` produces 3, 1. -}
export let dropWhile(source: Seq(a), discard: a -> Bool): Seq(a) =
    Seq({ pull = () =>
        var current = source
        var result = None
        var searching = True
        while searching
            match next(current)
                None => searching := False
                Some((value, rest)) =>
                    if discard(value) then
                        current := rest
                    else
                        result := Some((value, rest))
                        searching := False
        result
    })

-- `flatMap` with the partially consumed inner sequence carried between pulls.
fun flatMapWith(source: Seq(a), transform: a -> Seq(b), pending: Seq(b)): Seq(b) =
    Seq({ pull = () =>
        var outer = source
        var inner = pending
        var result = None
        var searching = True
        while searching
            match next(inner)
                Some((value, rest)) =>
                    result := Some((value, flatMapWith(outer, transform, rest)))
                    searching := False
                None =>
                    match next(outer)
                        None => searching := False
                        Some((outerValue, outerRest)) =>
                            outer := outerRest
                            inner := transform(outerValue)
        result
    })

{-- A new sequence made by calling the function `transform` on each element and
    joining the sequences it returns end to end:\
    `[1, 2].toSeq().flatMap(n => [n, n * 10])` produces 1, 10, 2, 20.\
    `transform` may return vectors as well. To join a sequence of vectors or of
    sequences into one, write:\
    `rows.flatMap(row => row)` -}
export let flatMap(source: Seq(a), transform: a -> Seq(b)): Seq(b) =
    flatMapWith(source, transform, empty)

-- Consumers: drive a `Seq` to a value.

{-- Combines the elements into one result. It starts with the value `initial`.
    For each element, from first to last, it calls the function `combine` with
    the result so far and that element, and what `combine` returns becomes the
    result:\
    `[1, 2, 3].toSeq().fold(0, (total, n) => total + n)` is `6`.\
    It reads every element, so it never returns for a sequence that has no
    end. -}
export let fold(source: Seq(a), initial: b, combine: (b, a) ->! b): b =
    var accumulator = initial
    var current = source
    var running = True
    while running
        match next(current)
            None => running := False
            Some((value, rest)) =>
                accumulator := combine!(accumulator, value)
                current := rest
    accumulator

{-- The number of elements. It reads every element to count them, so it never
    returns for a sequence that has no end. -}
export let length(source: Seq(a)): Int =
    var total = 0
    var current = source
    var running = True
    while running
        match next(current)
            None => running := False
            Some((_, rest)) =>
                total := total + 1
                current := rest
    total

{-- Calls the function `action` on each element, from first to last. It is for
    what `action` does, such as printing, since nothing is returned. It never
    returns for a sequence that has no end. -}
export let forEach(source: Seq(a), action: a ->! Unit): Unit =
    var current = source
    var running = True
    while running
        match next(current)
            None => running := False
            Some((value, rest)) =>
                action!(value)
                current := rest

{-- The first element for which the function `matches` returns `True`, or `None`
    when there is none. It stops at that element and does not read the rest, so
    it returns even for a sequence without end, as long as such an element
    exists. -}
export let find(source: Seq(a), matches: a ->! Bool): Option(a) =
    var current = source
    var result = None
    var searching = True
    while searching
        match next(current)
            None => searching := False
            Some((value, rest)) =>
                if matches!(value) then
                    result := Some(value)
                    searching := False
                else
                    current := rest
    result

{-- Whether the function `matches` returns `True` for at least one element. It
    stops at the first one that does. -}
export let any(source: Seq(a), matches: a ->! Bool): Bool =
    match find!(source, matches)
        None => False
        Some(_) => True

{-- Whether the function `matches` returns `True` for every element. It stops at
    the first one that does not. An empty sequence gives `True`. -}
export let all(source: Seq(a), matches: a ->! Bool): Bool =
    not any!(source, value => not matches!(value))

-- Extremes and totals (`collection-combinators.md` section 13), each one pass
-- of `fold`, so each pulls the whole sequence and does not return on an
-- infinite one. Of items that tie, `min` keeps the first and `max` the last.
--
-- The `Using` forms write their steps' parameter types: a match on the
-- comparator's answer is not decided without them (#1433). Each arm names
-- its constructor bare, `Greater`, which a pattern reads against the matched
-- value's own `Ordering` (Pattern Matching section 2.2).

-- One step of `maxBy`: the ranked item replaces the best unless the best's key
-- is greater.
let laterBy<b: Ord>(best: Option((b, a)), ranked: (b, a)): Option((b, a)) =
    match (best, ranked)
        (Some((keptKey, _)), (rankedKey, _)) =>
            match Ord.compare(keptKey, rankedKey)
                Greater => best
                _ => Some(ranked)
        _ => Some(ranked)

-- One step of `minBy`: the ranked item replaces the best only when the best's
-- key is greater.
let earlierBy<b: Ord>(best: Option((b, a)), ranked: (b, a)): Option((b, a)) =
    match (best, ranked)
        (Some((keptKey, _)), (rankedKey, _)) =>
            match Ord.compare(keptKey, rankedKey)
                Greater => Some(ranked)
                _ => best
        _ => Some(ranked)

let unranked(best: Option((b, a))): Option(a) = match best
    Some((_, value)) => Some(value)
    None => None

{-- The largest element, or `None` when the sequence is empty. The function
    `compare` decides which of two elements is larger: it is given two elements
    and returns `Greater` when the first is larger, `Less` when it is smaller,
    and `Equal` when neither is. If several elements are equally large, the
    result is the last of them. -}
export let maxUsing(source: Seq(a), compare: (a, a) ->! Ordering): Option(a) =
    fold!(source, None, (best: Option(a), value: a) => match best
        Some(kept) => match compare!(kept, value)
            Greater => best
            _ => Some(value)
        None => Some(value))

{-- The smallest element, or `None` when the sequence is empty. The function
    `compare` decides which of two elements is smaller: it is given two elements
    and returns `Less` when the first is smaller, `Greater` when it is larger,
    and `Equal` when neither is. If several elements are equally small, the
    result is the first of them. -}
export let minUsing(source: Seq(a), compare: (a, a) ->! Ordering): Option(a) =
    fold!(source, None, (best: Option(a), value: a) => match best
        Some(kept) => match compare!(kept, value)
            Greater => Some(value)
            _ => best
        None => Some(value))

{-- The largest element, or `None` when the sequence is empty. -}
export let max<a: Ord>(source: Seq(a)): Option(a) = maxUsing(source, Ord.compare)

{-- The smallest element, or `None` when the sequence is empty. -}
export let min<a: Ord>(source: Seq(a)): Option(a) = minUsing(source, Ord.compare)

{-- The element for which the function `key` returns the largest value, or
    `None` when the sequence is empty:\
    `words.maxBy(word => word.length())` finds the longest word.\
    If `key` returns the largest value for several elements, the result is the
    last of them. -}
export let maxBy<b: Ord>(source: Seq(a), key: a ->! b): Option(a) =
    unranked(fold!(source, None, (best, value) => laterBy(best, (key!(value), value))))

{-- The element for which the function `key` returns the smallest value, or
    `None` when the sequence is empty:\
    `words.minBy(word => word.length())` finds the shortest word.\
    If `key` returns the smallest value for several elements, the result is the
    first of them. -}
export let minBy<b: Ord>(source: Seq(a), key: a ->! b): Option(a) =
    unranked(fold!(source, None, (best, value) => earlierBy(best, (key!(value), value))))

{-- The elements added together. -}
export let sum<a: Num>(source: Seq(a)): a = fold(source, 0, Num.add)

{-- The elements multiplied together. An empty sequence gives 1. -}
export let product<a: Num>(source: Seq(a)): a = fold(source, 1, Num.multiply)
