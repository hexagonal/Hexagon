module Seq

(** Raised when a sequence position is forced while it is already being
    forced, or when `JsValue.toArray` is asked for a value whose copy it is
    making (FFI Part 3 section 7.3-7.4). *)
export fault ReentrancyFault

(** A lazy, immutable, possibly infinite sequence of `a`s. Constructing a
    combinator computes nothing; each element is produced on demand by `next`,
    and produced again on every later traversal unless the sequence is
    `memoize`d. *)
opaque record Seq(+a) = { pull: () -> Option((a, Seq(a))) }

extern from "hex:intrinsic"
    (** Computes each element of `source` at most once however often the result
        is traversed, at the cost of retaining what has been produced. *)
    export fun seqMemoize as memoize(source: Seq(a)) -> Seq(a)

(** Drives one step: the head element and the successor sequence, or `None` when
    exhausted. `source` itself is unchanged. *)
export let next(source: Seq(a)): Option((a, Seq(a))) = (source.pull)()

// Producers, and combinators whose step yields at most one element per pull.

(** The empty sequence. *)
export let empty: Seq(a) = Seq({ pull = () => None })

(** A sequence with a single value. *)
export let singleton(value: a): Seq(a) = Seq({ pull = () => Some((value, empty)) })

(** The sequence that yields `value`, then everything in `rest`. *)
export let prepend(rest: Seq(a), value: a): Seq(a) = Seq({ pull = () => Some((value, rest)) })

(** The infinite sequence `seed`, `step(seed)`, `step(step(seed))`, and so on.
    Bound it with `take` or `takeWhile` before consuming it. *)
export fun iterate(seed: a, step: a -> a): Seq(a) =
    Seq({ pull = () => Some((seed, iterate(step(seed), step))) })

(** Applies `transform` to each element as that element is pulled. A traversal
    calls `transform` once per element, so two traversals call it twice —
    `memoize` the result when it is expensive. *)
export fun map(source: Seq(a), transform: a -> b): Seq(b) =
    Seq({ pull = () =>
        match next(source)
            None => None
            Some((value, rest)) => Some((transform(value), map(rest, transform)))
    })

(** The first `count` elements of `source`, or all of them if it is shorter. A
    `count` of zero or less gives the empty sequence. *)
export fun take(source: Seq(a), count: Int): Seq(a) =
    if count <= 0 then
        empty
    else
        Seq({ pull = () =>
            match next(source)
                None => None
                Some((value, rest)) => Some((value, take(rest, count - 1)))
        })

(** The longest leading run of elements satisfying `keep`. The first element
    that fails ends the sequence and is not part of it. *)
export fun takeWhile(source: Seq(a), keep: a -> Bool): Seq(a) =
    Seq({ pull = () =>
        match next(source)
            None => None
            Some((value, rest)) =>
                if keep(value) then
                    Some((value, takeWhile(rest, keep)))
                else
                    None
    })

(** Grows a sequence from `seed`: each step produces one element and the seed
    for the next, and `None` ends it. The mirror of `fold`, which consumes one. *)
export fun unfold(seed: b, produce: b -> Option((a, b))): Seq(a) =
    Seq({ pull = () =>
        match produce(seed)
            None => None
            Some((value, nextSeed)) => Some((value, unfold(nextSeed, produce)))
    })

(** Combines elements pairwise with `combine`, ending as soon as either side
    runs out. *)
export fun zipWith(left: Seq(a), right: Seq(b), combine: (a, b) -> c): Seq(c) =
    Seq({ pull = () =>
        match next(left)
            None => None
            Some((leftValue, leftRest)) =>
                match next(right)
                    None => None
                    Some((rightValue, rightRest)) =>
                        Some((combine(leftValue, rightValue), zipWith(leftRest, rightRest, combine)))
    })

(** Pairs elements positionally, ending as soon as either side runs out. *)
export let zip(left: Seq(a), right: Seq(b)): Seq((a, b)) =
    zipWith(left, right, (leftValue, rightValue) => (leftValue, rightValue))

(** The elements of `first`, then those of `second`. `second` is not pulled
    until `first` is exhausted, so an infinite `first` never reaches it. *)
export fun concat(first: Seq(a), second: Seq(a)): Seq(a) =
    Seq({ pull = () =>
        match next(first)
            None => next(second)
            Some((value, rest)) => Some((value, concat(rest, second)))
    })

// Combinators whose step may consume many source elements to yield one.

(** The elements of `source` satisfying `keep`. One pull consumes source
    elements until it finds one, so pulling past the last match runs the source
    to exhaustion — and does not return at all if the source is infinite. *)
export fun filter(source: Seq(a), keep: a -> Bool): Seq(a) =
    Seq({ pull = () =>
        var current = source
        var result = None
        var searching = True
        while searching
            match next(current)
                None => searching := False
                Some((value, rest)) =>
                    if keep(value) then
                        result := Some((value, filter(rest, keep)))
                        searching := False
                    else
                        current := rest
        result
    })

(** `source` without its first `count` elements. They are skipped on the first
    pull of the result, not when `drop` is called. *)
export let drop(source: Seq(a), count: Int): Seq(a) =
    Seq({ pull = () =>
        var current = source
        var remaining = count
        var result = None
        var running = True
        while running
            if remaining <= 0 then
                result := next(current)
                running := False
            else
                match next(current)
                    None => running := False
                    Some((_, rest)) =>
                        current := rest
                        remaining := remaining - 1
        result
    })

(** `source` from its first element that fails `discard` onward. Like `drop`,
    the skipping happens on the first pull of the result. *)
export let dropWhile(source: Seq(a), discard: a -> Bool): Seq(a) =
    Seq({ pull = () =>
        var current = source
        var result = None
        var searching = True
        while searching
            match next(current)
                None => searching := False
                Some((value, rest)) =>
                    if discard(value) then
                        current := rest
                    else
                        result := Some((value, rest))
                        searching := False
        result
    })

// `flatMap` with the partially consumed inner sequence carried between pulls.
fun flatMapWith(source: Seq(a), transform: a -> Seq(b), pending: Seq(b)): Seq(b) =
    Seq({ pull = () =>
        var outer = source
        var inner = pending
        var result = None
        var searching = True
        while searching
            match next(inner)
                Some((value, rest)) =>
                    result := Some((value, flatMapWith(outer, transform, rest)))
                    searching := False
                None =>
                    match next(outer)
                        None => searching := False
                        Some((outerValue, outerRest)) =>
                            outer := outerRest
                            inner := transform(outerValue)
        result
    })

(** The sequences `transform` produces, concatenated in order. Each is pulled to
    exhaustion before the next source element is read. To flatten a sequence of
    vectors or of sequences, write `Seq.flatMap(rows, row => row)`. *)
export let flatMap(source: Seq(a), transform: a -> Seq(b)): Seq(b) =
    flatMapWith(source, transform, empty)

// Consumers: drive a `Seq` to a value.

(** Reduces the whole sequence to one value, left to right, starting from
    `initial`. It pulls every element, so it does not return on an infinite
    sequence. *)
export let fold(source: Seq(a), initial: b, combine: (b, a) ->! b): b =
    var accumulator = initial
    var current = source
    var running = True
    while running
        match next(current)
            None => running := False
            Some((value, rest)) =>
                accumulator := combine!(accumulator, value)
                current := rest
    accumulator

(** How many elements `source` yields. It pulls all of them, so it does not
    return on an infinite sequence. *)
export let length(source: Seq(a)): Int =
    var total = 0
    var current = source
    var running = True
    while running
        match next(current)
            None => running := False
            Some((_, rest)) =>
                total := total + 1
                current := rest
    total

(** Runs `action` on each element in order, for its effect. It pulls the whole
    sequence, so it does not return on an infinite one. *)
export let forEach(source: Seq(a), action: a ->! Unit): Unit =
    var current = source
    var running = True
    while running
        match next(current)
            None => running := False
            Some((value, rest)) =>
                action!(value)
                current := rest

(** The first element satisfying `matches`, or `None` if none does. It stops at
    that element, so it is safe on an infinite sequence that contains one. *)
export let find(source: Seq(a), matches: a ->! Bool): Option(a) =
    var current = source
    var result = None
    var searching = True
    while searching
        match next(current)
            None => searching := False
            Some((value, rest)) =>
                if matches!(value) then
                    result := Some(value)
                    searching := False
                else
                    current := rest
    result

(** Whether any element satisfies `matches`, stopping at the first that does. *)
export let any(source: Seq(a), matches: a ->! Bool): Bool =
    match find!(source, matches)
        None => False
        Some(_) => True

(** Whether every element satisfies `matches`, stopping at the first that does
    not. *)
export let all(source: Seq(a), matches: a ->! Bool): Bool =
    not any!(source, value => not matches!(value))

// Extremes and totals (`collection-combinators.md` section 13), each one pass
// of `fold`, so each pulls the whole sequence and does not return on an
// infinite one. Of items that tie, `min` keeps the first and `max` the last.
//
// The `Using` forms write their steps' parameter types: a match on the
// comparator's answer is not decided without them (#1433). Each arm names
// its constructor bare, `Greater`, which a pattern reads against the matched
// value's own `Ordering` (Pattern Matching section 2.2).

// One step of `maxBy`: the ranked item replaces the best unless the best's key
// is greater.
let laterBy<b: Ord>(best: Option((b, a)), ranked: (b, a)): Option((b, a)) =
    match (best, ranked)
        (Some((keptKey, _)), (rankedKey, _)) =>
            match Ord.compare(keptKey, rankedKey)
                Greater => best
                _ => Some(ranked)
        _ => Some(ranked)

// One step of `minBy`: the ranked item replaces the best only when the best's
// key is greater.
let earlierBy<b: Ord>(best: Option((b, a)), ranked: (b, a)): Option((b, a)) =
    match (best, ranked)
        (Some((keptKey, _)), (rankedKey, _)) =>
            match Ord.compare(keptKey, rankedKey)
                Greater => Some(ranked)
                _ => best
        _ => Some(ranked)

let unranked(best: Option((b, a))): Option(a) = match best
    Some((_, value)) => Some(value)
    None => None

(** The element of `source` that `compare` ranks greatest, or `None` when
    `source` is empty, and of elements it ranks equal, the last. `compare` runs
    once for each element after the first, as `compare(best, element)`. *)
export let maxUsing(source: Seq(a), compare: (a, a) ->! Ordering): Option(a) =
    fold!(source, None, (best: Option(a), value: a) => match best
        Some(kept) => match compare!(kept, value)
            Greater => best
            _ => Some(value)
        None => Some(value))

(** The element of `source` that `compare` ranks least, or `None` when `source`
    is empty, and of elements it ranks equal, the first. `compare` runs once for
    each element after the first, as `compare(best, element)`. *)
export let minUsing(source: Seq(a), compare: (a, a) ->! Ordering): Option(a) =
    fold!(source, None, (best: Option(a), value: a) => match best
        Some(kept) => match compare!(kept, value)
            Greater => Some(value)
            _ => best
        None => Some(value))

(** The greatest element of `source` under its `Ord`, or `None` when `source` is
    empty, and of equal greatest elements, the last. *)
export let max<a: Ord>(source: Seq(a)): Option(a) = maxUsing(source, Ord.compare)

(** The least element of `source` under its `Ord`, or `None` when `source` is
    empty, and of equal least elements, the first. *)
export let min<a: Ord>(source: Seq(a)): Option(a) = minUsing(source, Ord.compare)

(** The element of `source` whose key is greatest, or `None` when `source` is
    empty, and of elements whose keys are equal, the last. `key` runs once per
    element, in order. *)
export let maxBy<b: Ord>(source: Seq(a), key: a ->! b): Option(a) =
    unranked(fold!(source, None, (best, value) => laterBy(best, (key!(value), value))))

(** The element of `source` whose key is least, or `None` when `source` is
    empty, and of elements whose keys are equal, the first. `key` runs once per
    element, in order. *)
export let minBy<b: Ord>(source: Seq(a), key: a ->! b): Option(a) =
    unranked(fold!(source, None, (best, value) => earlierBy(best, (key!(value), value))))

(** The elements of `source` added in order, starting from zero, so the empty
    sequence's sum is zero. *)
export let sum<a: Num>(source: Seq(a)): a = fold(source, 0, Num.add)

(** The elements of `source` multiplied in order, starting from one, so the
    empty sequence's product is one. *)
export let product<a: Num>(source: Seq(a)): a = fold(source, 1, Num.multiply)
