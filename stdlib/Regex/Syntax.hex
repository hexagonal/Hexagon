    ("Psalter_Pahlavi", "Psalter_Pahlavi"), ("Phnx", "Phoenician"), ("Phoenician", "Phoenician"),
    ("Plrd", "Miao"), ("Miao", "Miao"), ("Prti", "Inscriptional_Parthian"),
    ("Inscriptional_Parthian", "Inscriptional_Parthian"), ("Rjng", "Rejang"), ("Rejang", "Rejang"),
    ("Rohg", "Hanifi_Rohingya"), ("Hanifi_Rohingya", "Hanifi_Rohingya"), ("Runr", "Runic"),
    ("Runic", "Runic"), ("Samr", "Samaritan"), ("Samaritan", "Samaritan"),
    ("Sarb", "Old_South_Arabian"), ("Old_South_Arabian", "Old_South_Arabian"),
    ("Saur", "Saurashtra"), ("Saurashtra", "Saurashtra"), ("Sgnw", "SignWriting"),
    ("SignWriting", "SignWriting"), ("Shaw", "Shavian"), ("Shavian", "Shavian"),
    ("Shrd", "Sharada"), ("Sharada", "Sharada"), ("Sidd", "Siddham"), ("Siddham", "Siddham"),
    ("Sidt", "Sidetic"), ("Sidetic", "Sidetic"), ("Sind", "Khudawadi"), ("Khudawadi", "Khudawadi"),
    ("Sinh", "Sinhala"), ("Sinhala", "Sinhala"), ("Sogd", "Sogdian"), ("Sogdian", "Sogdian"),
    ("Sogo", "Old_Sogdian"), ("Old_Sogdian", "Old_Sogdian"), ("Sora", "Sora_Sompeng"),
    ("Sora_Sompeng", "Sora_Sompeng"), ("Soyo", "Soyombo"), ("Soyombo", "Soyombo"),
    ("Sund", "Sundanese"), ("Sundanese", "Sundanese"), ("Sunu", "Sunuwar"), ("Sunuwar", "Sunuwar"),
    ("Sylo", "Syloti_Nagri"), ("Syloti_Nagri", "Syloti_Nagri"), ("Syrc", "Syriac"),
    ("Syriac", "Syriac"), ("Tagb", "Tagbanwa"), ("Tagbanwa", "Tagbanwa"), ("Takr", "Takri"),
    ("Takri", "Takri"), ("Tale", "Tai_Le"), ("Tai_Le", "Tai_Le"), ("Talu", "New_Tai_Lue"),
    ("New_Tai_Lue", "New_Tai_Lue"), ("Taml", "Tamil"), ("Tamil", "Tamil"), ("Tang", "Tangut"),
    ("Tangut", "Tangut"), ("Tavt", "Tai_Viet"), ("Tai_Viet", "Tai_Viet"), ("Tayo", "Tai_Yo"),
    ("Tai_Yo", "Tai_Yo"), ("Telu", "Telugu"), ("Telugu", "Telugu"), ("Tfng", "Tifinagh"),
    ("Tifinagh", "Tifinagh"), ("Tglg", "Tagalog"), ("Tagalog", "Tagalog"), ("Thaa", "Thaana"),
    ("Thaana", "Thaana"), ("Thai", "Thai"), ("Tibt", "Tibetan"), ("Tibetan", "Tibetan"),
    ("Tirh", "Tirhuta"), ("Tirhuta", "Tirhuta"), ("Tnsa", "Tangsa"), ("Tangsa", "Tangsa"),
    ("Todr", "Todhri"), ("Todhri", "Todhri"), ("Tols", "Tolong_Siki"),
    ("Tolong_Siki", "Tolong_Siki"), ("Toto", "Toto"), ("Tutg", "Tulu_Tigalari"),
    ("Tulu_Tigalari", "Tulu_Tigalari"), ("Ugar", "Ugaritic"), ("Ugaritic", "Ugaritic"),
    ("Vaii", "Vai"), ("Vai", "Vai"), ("Vith", "Vithkuqi"), ("Vithkuqi", "Vithkuqi"),
    ("Wara", "Warang_Citi"), ("Warang_Citi", "Warang_Citi"), ("Wcho", "Wancho"),
    ("Wancho", "Wancho"), ("Xpeo", "Old_Persian"), ("Old_Persian", "Old_Persian"),
    ("Xsux", "Cuneiform"), ("Cuneiform", "Cuneiform"), ("Yezi", "Yezidi"), ("Yezidi", "Yezidi"),
    ("Yiii", "Yi"), ("Yi", "Yi"), ("Zanb", "Zanabazar_Square"),
    ("Zanabazar_Square", "Zanabazar_Square"), ("Zinh", "Inherited"), ("Inherited", "Inherited"),
    ("Zyyy", "Common"), ("Common", "Common"), ("Zzzz", "Unknown"), ("Unknown", "Unknown"),
])

let binaryNames: Map(String, String) = Map.fromVector([
    ("Alpha", "Alphabetic"), ("Alphabetic", "Alphabetic"), ("Upper", "Uppercase"),
    ("Uppercase", "Uppercase"), ("Lower", "Lowercase"), ("Lowercase", "Lowercase"),
    ("WSpace", "White_Space"), ("White_Space", "White_Space"), ("space", "White_Space"),
    ("NChar", "Noncharacter_Code_Point"), ("Noncharacter_Code_Point", "Noncharacter_Code_Point"),
    ("DI", "Default_Ignorable_Code_Point"),
    ("Default_Ignorable_Code_Point", "Default_Ignorable_Code_Point"),
])
// END GENERATED NAMES

// ---------------------------------------------------------------------------
// Property names (§2.4)

// The spelling a property was written with, for a message: `\p{Greek}` or `\pL`.
let writtenProperty(letter: String, body: String, braced: Bool): String =
    if braced then "\\" ++ letter ++ "{" ++ body ++ "}" else "\\" ++ letter ++ body

let separatorAt(body: String): Option(Int) =
    var at = 1
    var found = None
    for point in body
        if isAbsent(found) and (point == "=" or point == ":") then found := Some(at)
        at := at + 1
    found

// The kind a property name before `=` selects. Only the three enumerated
// properties take a value; the binary properties have no `=Yes` form.
let valueKind(property: String): Option(PropertyKind) =
    if property == "gc" or property == "General_Category" then
        Some(GeneralCategory)
    else if property == "sc" or property == "Script" then
        Some(Script)
    else if property == "scx" or property == "Script_Extensions" then
        Some(ScriptExtensions)
    else
        None

let tableOf(kind: PropertyKind): Map(String, String) = match kind
    GeneralCategory => generalCategoryNames
    Script => scriptNames
    ScriptExtensions => scriptNames
    _ => Map.empty

let lookupValue(kind: PropertyKind, value: String): Option(String) = Map.get(tableOf(kind), value)

// A bare name: a General_Category value, then a Script value, then a binary
// property, then `Any`, `ASCII`, `Assigned` (§2.4; the spaces are disjoint).
let lookupBare(name: String): Option((PropertyKind, String)) =
    match Map.get(generalCategoryNames, name)
        Some(value) => Some((GeneralCategory, value))
        None => match Map.get(scriptNames, name)
            Some(value) => Some((Script, value))
            None => match Map.get(binaryNames, name)
                Some(value) => Some((Binary, value))
                None =>
                    if name == "Any" then
                        Some((Any, ""))
                    else if name == "ASCII" then
                        Some((Ascii, ""))
                    else if name == "Assigned" then
                        Some((Assigned, ""))
                    else
                        None

// A name with case, underscores, hyphens and spaces erased, for the advice a
// refused loose spelling gets.
let loosened(name: String): String =
    var chunks: Vector(String) = []
    for point in name
        let code = codeOf(point)
        if not (point == "_" or point == "-" or point == " ") then
            chunks := chunks.append(if code >= 65 and code <= 90 then String.toLower(point) else point)
    String.join(Iterable.toSeq(chunks), "")

let looseIn(names: Vector(String), name: String): Option(String) =
    let wanted = loosened(name)
    var found = None
    for candidate in names
        if isAbsent(found) and loosened(candidate) == wanted then found := Some(candidate)
    found

let spellings(table: Map(String, String)): Vector(String) = Vector.fromSeq(Map.keys(table))

// The canonical spelling of the table entry `name` loosely matches.
let looseCanonical(table: Map(String, String), name: String): Option(String) =
    match looseIn(spellings(table), name)
        Some(alias) => Map.get(table, alias)
        None => None

let looseValue(kind: PropertyKind, value: String): Option(String) = looseCanonical(tableOf(kind), value)

let looseOrExact(kind: PropertyKind, value: String): Option(String) = match lookupValue(kind, value)
    Some(canonical) => Some(canonical)
    None => looseValue(kind, value)

let looseProperty(property: String): Option(String) =
    looseIn(["gc", "General_Category", "sc", "Script", "scx", "Script_Extensions"], property)

let looseBare(name: String): Option(String) =
    match looseCanonical(generalCategoryNames, name)
        Some(found) => Some(found)
        None => match looseCanonical(scriptNames, name)
            Some(found) => Some(found)
            None => match looseCanonical(binaryNames, name)
                Some(found) => Some(found)
                None => looseIn(["Any", "ASCII", "Assigned"], name)

let smaller(left: Int, right: Int): Int = if left < right then left else right

// The edit distance between two codepoint vectors, counting an adjacent
// transposition as one edit, as the checker's near miss counts it: Levenshtein
// over rolling rows, with the row before the last kept for the transposition.
let editDistance(left: Vector(String), right: Vector(String)): Int =
    let width = Vector.length(right)
    var earlier: Vector(Int) = []
    var previous: Vector(Int) = []
    var column = 0
    while column <= width
        previous := previous.append(column)
        column := column + 1
    var row = 1
    while row <= Vector.length(left)
        var current: Vector(Int) = [row]
        var other = 1
        while other <= width
            let substituted = previous[other] + (if left[row] == right[other] then 0 else 1)
            var distance = smaller(substituted, smaller(current[other] + 1, previous[other + 1] + 1))
            if row > 1 and other > 1 and left[row] == right[other - 1] and left[row - 1] == right[other] then
                distance := smaller(distance, earlier[other - 1] + 1)
            current := current.append(distance)
            other := other + 1
        earlier := previous
        previous := current
        row := row + 1
    previous[width + 1]

// The spelling among `candidates` nearest `written`, offered only where it is
// within a third of its own length, at least one edit: the compiler's
// near-miss rule (Pattern Matching §12). A tie goes to the spelling that sorts
// first, so the answer never depends on a table's order. A one-codepoint name
// has no near miss, since every other one-codepoint name is one edit away.
let nearest(candidates: Vector(String), written: String): Option(String) =
    let wanted = points(written)
    let size = Vector.length(wanted)
    var best: Option((String, Int)) = None
    for candidate in candidates
        let other = points(candidate)
        let gap = if Vector.length(other) > size then Vector.length(other) - size else size - Vector.length(other)
        let worth = match best
            Some((_, known)) => gap <= known
            None => True
        if worth then
            let distance = editDistance(wanted, other)
            let better = match best
                Some((spelling, known)) => distance < known or (distance == known and candidate < spelling)
                None => True
            if better then best := Some((candidate, distance))
    match best
        Some((spelling, distance)) =>
            let room = Int.div(String.length(spelling), 3)
            if size > 1 and distance <= (if room > 1 then room else 1) then Some(spelling) else None
        None => None

// The supported spelling nearest a `\p` body that names nothing, for the
// near miss its refusal offers.
let nearProperty(body: String): Option(String) =
    match separatorAt(body)
        Some(at) =>
            let property = slice(body, 1, at - 1)
            let separator = body[at..at]
            let value = slice(body, at + 1, String.length(body))
            match valueKind(property)
                Some(kind) => prefixed(property ++ separator, nearest(spellings(tableOf(kind)), value))
                // A near name is offered only with a value it has: first the
                // nearest of the names that have the value written, then the
                // nearest name with that value's own near miss.
                None =>
                    let names = ["gc", "General_Category", "sc", "Script", "scx", "Script_Extensions"]
                    var having: Vector(String) = []
                    for name in names
                        match valueKind(name)
                            Some(kind) => match lookupValue(kind, value)
                                Some(_) => having := having.append(name)
                                None => ()
                            None => ()
                    match nearest(having, property)
                        Some(near) => Some(near ++ separator ++ value)
                        None => match nearest(names, property)
                            Some(near) => match valueKind(near)
                                Some(kind) => prefixed(near ++ separator, nearest(spellings(tableOf(kind)), value))
                                None => None
                            None => None
        None =>
            var candidates: Vector(String) = ["Any", "ASCII", "Assigned"]
            for table in [generalCategoryNames, scriptNames, binaryNames]
                for spelling in spellings(table)
                    candidates := candidates.append(spelling)
            nearest(candidates, body)

// The property a `\p` body names, by exact spelling; or, refused, the canonical
// spelling of what it loosely matches, if anything (§2.4: no loose matching, but
// the message names the spelling).
let lookupProperty(body: String): Outcome((PropertyKind, String), Option(String)) =
    match separatorAt(body)
        Some(at) =>
            let property = slice(body, 1, at - 1)
            let separator = body[at..at]
            let value = slice(body, at + 1, String.length(body))
            match valueKind(property)
                Some(kind) => match lookupValue(kind, value)
                    Some(canonical) => Read((kind, canonical))
                    None => Refused(prefixed(property ++ separator, looseValue(kind, value)))
                None => Refused(match looseProperty(property)
                    Some(spelling) => match valueKind(spelling)
                        Some(kind) => prefixed(spelling ++ separator, looseOrExact(kind, value))
                        None => None
                    None => None)
        None => match lookupBare(body)
            Some(found) => Read(found)
            None => Refused(looseBare(body))

let propertyEscape(
    found: Outcome((PropertyKind, String), Option(String)),
    letter: String,
    body: String,
    braced: Bool,
    negated: Bool,
    position: Int,
    next: Int,
): Outcome((Escaped, Int), Refusal) =
    match found
        Read((kind, value)) => Read((perl(kind, value, negated), next))
        Refused(suggestion) =>
            let written = writtenProperty(letter, body, braced)
            match suggestion
                Some(spelling) =>
                    let spelled = "\\" ++ letter ++ "{" ++ spelling ++ "}"
                    let message = "`" ++ written ++ "` names no supported property; write `" ++ spelled ++ "`"
                    Refused(fixed(message, position, [writing("write `" ++ spelled ++ "`", position, next, spelled)]))
                None =>
                    // A near miss is a guess, so it names no edit.
                    let advice = match nearProperty(body)
                        Some(spelling) => "; did you mean `\\" ++ letter ++ "{" ++ spelling ++ "}`?"
                        None => ""
                    Refused(fault("`" ++ written ++ "` names no supported property" ++ advice, position))

// `\p{…}` or `\pL` whose backslash is at `position`.
let readProperty(pattern: String, text: Vector(String), position: Int, negated: Bool): Outcome((Escaped, Int), Refusal) =
    let size = Vector.length(text)
    let letter = if negated then "P" else "p"
    let badForm = fault("`\\" ++ letter ++ "` takes one letter or a braced name", position)
    let open = position + 2
    if open > size then
        Refused(badForm)
    else if text[open] == "{" then
        var close = open + 1
        while close <= size and text[close] != "}"
            close := close + 1
        if close > size or close == open + 1 then
            Refused(badForm)
        else
            let body = slice(pattern, open + 1, close - 1)
            let name = slice(pattern, open + 2, close - 1)
            let known = match lookupProperty(name)
                Read(_) => True
                Refused(_) => False
            if text[open + 1] == "^" and known then
                let other = if negated then "p" else "P"
                let spelled = "\\" ++ other ++ "{" ++ name ++ "}"
                let message = "`\\" ++ letter ++ "{^" ++ name ++ "}` is not a spelling; write `" ++ spelled ++ "`"
                Refused(fixed(message, position, [writing("write `" ++ spelled ++ "`", position, close + 1, spelled)]))
            else if text[open + 1] == "^" then
                Refused(fault("`\\" ++ letter ++ "{" ++ body ++ "}` names no supported property", position))
            else
                propertyEscape(lookupProperty(body), letter, body, True, negated, position, close + 1)
    else if isAsciiLetter(text[open]) then
        let body = text[open]
        propertyEscape(lookupProperty(body), letter, body, False, negated, position, open + 1)
    else
        Refused(badForm)

// ---------------------------------------------------------------------------
// Reading an escape (§2.3)

// `\u{H…}`, read whole: one to six hexadecimal digits, at most U+10FFFF, not a
// surrogate (Lexer §6.2's form and bounds).
let readCodeEscape(text: Vector(String), position: Int): Outcome((Escaped, Int), Refusal) =
    let size = Vector.length(text)
    let refusal = fault("`\\u{…}` takes one to six hexadecimal digits up to 10FFFF, not a surrogate", position)
    if position + 2 > size or text[position + 2] != "{" then
        Refused(refusal)
    else
        var at = position + 3
        var value = 0
        var digits = 0
        var reading = True
        while reading and at <= size
            match hexValue(text[at])
                Some(digit) =>
                    value := value * 16 + digit
                    digits := digits + 1
                    at := at + 1
                None => reading := False
        if digits == 0 or digits > 6 or at > size or text[at] != "}" then
            Refused(refusal)
        else if value > 1_114_111 or (value >= 55_296 and value <= 57_343) then
            Refused(refusal)
        else
            Read((EscapedPoint(value), at + 1))

// The escape whose backslash is at `position`, and the position after it.
let readEscape(pattern: String, text: Vector(String), position: Int): Outcome((Escaped, Int), Refusal) =
    let size = Vector.length(text)
    if position + 1 > size then
        let rewrite = writing("write `\\\\` for a literal backslash", size + 1, size + 1, "\\")
        Refused(fixed("pattern ends inside an escape; write `\\\\` for a literal backslash", size + 1, [rewrite]))
    else
        let letter = text[position + 1]
        let next = position + 2
        if not (isAsciiLetter(letter) or isAsciiDigit(letter)) then
            Read((EscapedPoint(codeOf(letter)), next))
        else
            match letter
                "n" => Read((EscapedPoint(10), next))
                "t" => Read((EscapedPoint(9), next))
                "r" => Read((EscapedPoint(13), next))
                "u" => readCodeEscape(text, position)
                "d" => Read((perl(GeneralCategory, "Nd", False), next))
                "D" => Read((perl(GeneralCategory, "Nd", True), next))
                "s" => Read((perl(Binary, "White_Space", False), next))
                "S" => Read((perl(Binary, "White_Space", True), next))
                "w" => Read((perl(Word, "", False), next))
                "W" => Read((perl(Word, "", True), next))
                "p" => readProperty(pattern, text, position, False)
                "P" => readProperty(pattern, text, position, True)
                "b" => Read((EscapedAnchor(WordBoundary, "\\b"), next))
                "B" => Read((EscapedAnchor(NotWordBoundary, "\\B"), next))
                "A" => Read((EscapedAnchor(TextStart, "\\A"), next))
                "z" => Read((EscapedAnchor(TextEnd, "\\z"), next))
                _ => match refusedEscape(letter)
                    Some(message) => Refused(fault(message, position))
                    // Another engine may read the escape as something else, such
                    // as `\o{…}` for an octal codepoint, so the letter is a guess.
                    None => Refused(fault("`\\" ++ letter ++ "` is not an escape; write `" ++ letter ++ "`, or see the escape table", position))

// ---------------------------------------------------------------------------
// Classes (§2.4)

// `ranges` with `[low, high]` added, kept sorted, disjoint and merged.
let addRange(ranges: Vector((Int, Int)), low: Int, high: Int): Vector((Int, Int)) =
    var result: Vector((Int, Int)) = []
    var pendingLow = low
    var pendingHigh = high
    var placed = False
    for (existingLow, existingHigh) in ranges
        if placed then
            result := result.append((existingLow, existingHigh))
        else if existingHigh + 1 < pendingLow then
            result := result.append((existingLow, existingHigh))
        else if pendingHigh + 1 < existingLow then
            result := result.append((pendingLow, pendingHigh)).append((existingLow, existingHigh))
            placed := True
        else
            pendingLow := if existingLow < pendingLow then existingLow else pendingLow
            pendingHigh := if existingHigh > pendingHigh then existingHigh else pendingHigh
    if placed then result else result.append((pendingLow, pendingHigh))

let complemented(items: Vector(ClassItem)): Vector(ClassItem) =
    var result: Vector(ClassItem) = []
    for item in items
        result := result.append(match item
            Property(kind, value, negated) => Property(kind, value, not negated)
            Range(low, high) => Range(low, high))
    result

let isAssertionLetter(letter: String): Bool = letter == "b" or letter == "B" or letter == "A" or letter == "z"

let rangeEndFault(position: Int): Refusal =
    let rewrite = writing("write `\\-` for a literal hyphen", position, position + 1, "\\-")
    fixed("a range's ends are single codepoints; write `\\-` for a literal hyphen", position, [rewrite])

// A `[` inside a class. Engines with nested classes, such as Java's, read it as
// opening one, and POSIX `[:`, `[=` and `[.` as a named set; `\[` keeps only the
// reading of a literal `[`, so it is offered only where no other reading closes:
// where no `]` follows the one that would close this class.
let innerBracketFault(text: Vector(String), position: Int): Refusal =
    let size = Vector.length(text)
    if position + 1 <= size and text[position + 1] == ":" then
        fault("`[` inside a class must be written `\\[`; POSIX classes are not part of the dialect; write `\\p{Alphabetic}`", position)
    else
        // The `]` the literal reading closes the class with, then any after it;
        // an escape is passed whole.
        var at = position + 1
        var closes = 0
        while at <= size and closes < 2
            if text[at] == "\\" then
                at := at + 2
            else
                if text[at] == "]" then closes := closes + 1
                at := at + 1
        let message = "`[` inside a class must be written `\\[`"
        if closes < 2 then
            fixed(message, position, [writing("write `\\[`", position, position + 1, "\\[")])
        else
            fault(message, position)

// One member at `position` inside a class: a codepoint or a class escape's items.
let readMember(pattern: String, text: Vector(String), position: Int): Outcome((Member, Int), Refusal) =
    let point = text[position]
    if point == "\\" then
        match readEscape(pattern, text, position)
            Read((EscapedPoint(value), next)) => Read((Single(value), next))
            Read((EscapedItems(items, negated), next)) =>
                Read((Several(if negated then complemented(items) else items), next))
            Read((EscapedAnchor(_, written), next)) =>
                let message = "`" ++ written ++ "` is an assertion, not a codepoint; a class cannot hold it, so write it outside the class"
                if written == "\\b" then
                    let rewrite = writing("write `\\u{8}` for a backspace", position, next, "\\u{8}")
                    Refused(fixed(message ++ ", or `\\u{8}` for a backspace", position, [rewrite]))
                else
                    Refused(fault(message, position))
            Refused(error) => Refused(error)
    else if point == "[" then
        Refused(innerBracketFault(text, position))
    else
        Read((Single(codeOf(point)), position + 1))

// The class whose `[` is at `open`, and the position after its `]`.
let readClass(pattern: String, text: Vector(String), open: Int, folded: Bool): Outcome((Expr, Int), Refusal) =
    let size = Vector.length(text)
    var position = open + 1
    var negated = False
    if position <= size and text[position] == "^" then
        negated := True
        position := position + 1
    let first = position
    var ranges: Vector((Int, Int)) = []
    var properties: Vector(ClassItem) = []
    var failure: Option(Refusal) = None
    var reading = True
    // No edit: JavaScript reads `[]` as matching nothing and `[^]` as matching
    // any codepoint, so `\]` is a guess at the engine meant (§2.9).
    if position <= size and text[position] == "]" then
        failure := Some(fault("empty class; write `\\]` for a literal `]`", open))
        reading := False
    while reading
        if position > size then
            let rewrites = [
                writing("close the class", size + 1, size + 1, "]"),
                writing("write `\\[` for a literal `[`", open, open + 1, "\\["),
            ]
            failure := Some(fixed("missing `]` for the class opened here; close it, or write `\\[` for a literal", open, rewrites))
            reading := False
        else if text[position] == "]" then
            position := position + 1
            reading := False
        else if text[position] == "-" and position != first and position + 1 <= size and text[position + 1] != "]" then
            failure := Some(rangeEndFault(position))
            reading := False
        else
            match readMember(pattern, text, position)
                Refused(error) =>
                    failure := Some(error)
                    reading := False
                Read((Several(items), next)) =>
                    properties := properties ++ items
                    position := next
                Read((Single(low), next)) =>
                    let hyphen = next
                    let isRange = hyphen + 1 <= size and text[hyphen] == "-" and text[hyphen + 1] != "]"
                    let highAt = hyphen + 1
                    let assertionEnd = isRange and highAt + 1 <= size and text[highAt] == "\\" and isAssertionLetter(text[highAt + 1])
                    if assertionEnd then
                        failure := Some(rangeEndFault(hyphen))
                        reading := False
                    else if not isRange then
                        ranges := addRange(ranges, low, low)
                        position := next
                    else
                        match readMember(pattern, text, highAt)
                            Refused(error) =>
                                failure := Some(error)
                                reading := False
                            Read((Several(_), _)) =>
                                failure := Some(rangeEndFault(hyphen))
                                reading := False
                            Read((Single(highValue), after)) =>
                                if highValue < low then
                                    let written = slice(pattern, position, after - 1)
                                    // A `^` moved to the front could open the class
                                    // negated, and a `-` there could read as a range's
                                    // hyphen, so each is written escaped.
                                    let highWritten = slice(pattern, highAt, after - 1)
                                    let highSpelled = if highWritten == "^" or highWritten == "-" then "\\" ++ highWritten else highWritten
                                    let swapped = highSpelled ++ "-" ++ slice(pattern, position, hyphen - 1)
                                    // A lone surrogate has no spelling a message can show
                                    // (§2.3), so the words name the swap, not its text.
                                    let lone = (low >= 55296 and low <= 57343) or (highValue >= 55296 and highValue <= 57343)
                                    if lone then
                                        let rewrite = Rewrite({ title = "swap its ends", edits = [edit(position, after, swapped)] })
                                        failure := Some(fixed("range `" ++ written ++ "` is reversed; swap its ends", highAt, [rewrite]))
                                    else
                                        let rewrite = writing("write `" ++ swapped ++ "`", position, after, swapped)
                                        failure := Some(fixed("range `" ++ written ++ "` is reversed; write `" ++ swapped ++ "`", highAt, [rewrite]))
                                    reading := False
                                else
                                    ranges := addRange(ranges, low, highValue)
                                    position := after
    match failure
        Some(error) => Refused(error)
        None =>
            var items: Vector(ClassItem) = []
            for (low, high) in ranges
                items := items.append(Range(low, high))
            Read((Class(items ++ properties, negated, folded), position))

// ---------------------------------------------------------------------------
// Repetition (§2.5)

let readDigits(text: Vector(String), position: Int): (Int, Int, Int) =
    let size = Vector.length(text)
    var at = position
    var value = 0
    while at <= size and isAsciiDigit(text[at])
        value := if value > 100_000 then value else value * 10 + digitValue(text[at])
        at := at + 1
    (value, at - position, at)

// The `{` at `open` that begins no counted repetition: built only when refused,
// since a count read whole is the common case.
let countFault(open: Int): Refusal =
    let rewrite = writing("write `\\{` for a literal `{`", open, open + 1, "\\{")
    fixed("`{` must begin a counted repetition `{n}`, `{n,}`, or `{n,m}`; write `\\{` for a literal", open, [rewrite])

// The counted repetition whose `{` is at `open`: its minimum, its maximum, and
// the position after its `}`; read whole, so no `x`-mode space may fall inside.
let readCount(text: Vector(String), open: Int): Outcome((Int, Option(Int), Int), Refusal) =
    let size = Vector.length(text)
    let (low, lowDigits, afterLow) = readDigits(text, open + 1)
    if lowDigits == 0 or afterLow > size then
        Refused(countFault(open))
    else if text[afterLow] == "}" then
        Read((low, Some(low), afterLow + 1))
    else if text[afterLow] != "," then
        Refused(countFault(open))
    else if afterLow + 1 <= size and text[afterLow + 1] == "}" then
        Read((low, None, afterLow + 2))
    else
        let (high, highDigits, afterHigh) = readDigits(text, afterLow + 1)
        if highDigits == 0 or afterHigh > size or text[afterHigh] != "}" then
            Refused(countFault(open))
        else
            Read((low, Some(high), afterHigh + 1))

// ---------------------------------------------------------------------------
// Groups and flags (§2.6)

let flagLetter(flags: Flags, letter: String, value: Bool): Flags = match letter
    "i" => { flags with folded = value }
    "m" => { flags with multiLine = value }
    "s" => { flags with dotAll = value }
    _ => { flags with extended = value }

// The flags of `(?flags)` or `(?flags:` whose first letter is at `position`, the
// position of its closing `)` or `:`, and whether it closed with `)`. `open`
// counts the groups a `)` at the end would close, this one included.
let readFlags(text: Vector(String), position: Int, opening: Int, open: Int, flags: Flags): Outcome((Flags, Int, Bool), Refusal) =
    let size = Vector.length(text)
    var at = position
    var result = flags
    var seen: Vector(String) = []
    var clearing = False
    var afterHyphen = 0
    var failure: Option(Refusal) = None
    var closed = False
    var reading = True
    while reading
        if at > size then
            failure := Some(unclosedGroup(opening, size, closingParens(open)))
            reading := False
        else
            let point = text[at]
            if point == ")" or point == ":" then
                if not clearing and Vector.length(seen) == 0 then
                    failure := Some(dropping("`(?)` sets no flag; drop it", at, "drop the `(?)`", text, opening, at + 1, flags.extended))
                else if clearing and afterHyphen == 0 and Vector.length(seen) == 0 and point == ")" then
                    failure := Some(dropping("`(?-)` sets no flag; drop it", at, "drop the `(?-)`", text, opening, at + 1, flags.extended))
                else if clearing and afterHyphen == 0 then
                    let rewrite = writing("drop the `-`", at - 1, at, "")
                    failure := Some(fixed("nothing follows `-`; name a flag to clear, or drop the `-`", at, [rewrite]))
                closed := point == ")"
                reading := False
            else if point == "-" and not clearing then
                clearing := True
                at := at + 1
            else if point == "i" or point == "m" or point == "s" or point == "x" then
                var earlier = 0
                var index = 0
                for letter in seen
                    index := index + 1
                    if letter == point then earlier := index
                if earlier > 0 then
                    // The second letter dropped leaves the first's meaning, so the
                    // drop is offered only where both sit on one side of the `-`.
                    let message = "`" ++ point ++ "` is set twice; write it once"
                    let refusal = if not clearing or earlier > Vector.length(seen) - afterHyphen then
                        fixed(message, at, [writing("drop the second `" ++ point ++ "`", at, at + 1, "")])
                    else
                        fault(message, at)
                    failure := Some(refusal)
                    reading := False
                else
                    seen := seen.append(point)
                    result := flagLetter(result, point, not clearing)
                    if clearing then afterHyphen := afterHyphen + 1
                    at := at + 1
            else if point == "U" and clearing then
                // Name what to drop: the letter alone where other letters share the
                // clearing side, else the `-U`, the `-U` of a group, or the whole setting.
                let next = if at + 1 <= size then text[at + 1] else ""
                let others = afterHyphen > 0 or (next != "" and next != ")" and next != ":")
                let drop = if others then
                    "drop the `U`"
                else if Vector.length(seen) > 0 then
                    "drop the `-U`"
                else if next == ":" then
                    "write `(?:` for `(?-U:`"
                else
                    "drop the `(?-U)`"
                // No edit: Java reads `U` as Unicode classes, which `-U` clears,
                // so the drop keeps only the other engines' reading (§2.9).
                failure := Some(fault("`U` is not a flag; the dialect has no ungreedy mode, so there is nothing to clear: " ++ drop, at))
                reading := False
            else if point == "U" then
                // No edit, as for `-U`: Java reads `(?U)` as Unicode classes, which
                // the dialect's are already, so the repetitions an ungreedy mode
                // would rewrite are a guess at the engine meant (§2.9).
                failure := Some(fault("`U` is not a flag; the dialect has no ungreedy mode, so write each repetition as `U` reads it: a greedy one lazy, such as `*?`, and a lazy one greedy", at))
                reading := False
            else
                failure := Some(fault("`" ++ point ++ "` is not a flag; the flags are `i`, `m`, `s`, `x`", at))
                reading := False
    match failure
        Some(error) => Refused(error)
        None => Read((result, at, closed))

// A group name after the `<` at `angle`.
let readName(pattern: String, text: Vector(String), angle: Int): Outcome(Opened, Refusal) =
    let size = Vector.length(text)
    var close = angle + 1
    while close <= size and text[close] != ">" and text[close] != ")"
        close := close + 1
    if close > size or text[close] == ")" then
        Refused(fault("group name is not closed; write `(?<year>…)`", angle))
    else
        let name = slice(pattern, angle + 1, close - 1)
        if isValidName(name) then
            Read(OpenedNamed(name, angle + 1, close + 1))
        else
            Refused(fault("group name must match `[A-Za-z_][A-Za-z0-9_]*`", angle + 1))

// The `(?` prefix whose `(` is at `opening`, with `open` groups a `)` at the end
// would close, its own included.
let readPrefix(pattern: String, text: Vector(String), opening: Int, open: Int, flags: Flags): Outcome(Opened, Refusal) =
    let size = Vector.length(text)
    let question = opening + 1
    let at = opening + 2
    let generic = fault("`(?` must be followed by `:`, `P<`, `<`, or flags", question)
    let next = if at + 1 <= size then text[at + 1] else ""
    if at > size then
        Refused(generic)
    else
        let point = text[at]
        if point == ":" then
            Read(OpenedGroup(flags, at + 1))
        else if point == "=" then
            Refused(fault("`(?=` is lookahead, which the dialect does not have", question))
        else if point == "!" then
            Refused(fault("`(?!` is negative lookahead, which the dialect does not have", question))
        else if point == "<" and next == "=" then
            Refused(fault("`(?<=` is lookbehind, which the dialect does not have", question))
        else if point == "<" and next == "!" then
            Refused(fault("`(?<!` is negative lookbehind, which the dialect does not have", question))
        else if point == "<" then
            readName(pattern, text, at)
        else if point == "P" and next == "<" then
            readName(pattern, text, at + 1)
        else if point == "P" and next == ">" then
            Refused(fault("`(?P>` is recursion, which the dialect does not have", question))
        else if point == "P" and next != "=" then
            Refused(generic)
        else if point == "P" then
            Refused(fault("`(?P=` is a backreference, which the dialect does not have", question))
        else if point == ">" then
            Refused(fault("`(?>` is an atomic group, which the dialect does not have", question))
        else if point == "#" then
            let message = "`(?#` begins a comment in other engines, which the dialect does not have; drop it, or under the `x` flag write the comment after `#`, ending it with a newline"
            var close = at + 1
            while close <= size and text[close] != ")"
                close := close + 1
            // A comment followed by a quantifier is neither dropped nor moved:
            // either would hand the quantifier to the piece before it.
            if close > size or quantifiedAt(text, close + 1, flags.extended) then
                Refused(fault(message, question))
            else
                let drop = writing("drop the comment", opening, close + 1, "")
                // Under `x`, the comment written after `#` ends at a newline, so
                // one whose text holds a newline would end early.
                let body = slice(pattern, at + 1, close - 1)
                if flags.extended and not String.contains(body, "\n") then
                    let comment = writing("write the comment after `#`", opening, close + 1, "#" ++ body ++ "\n")
                    Refused(fixed(message, question, [drop, comment]))
                else
                    Refused(fixed(message, question, [drop]))
        else if point == "(" then
            Refused(fault("`(?(` is a conditional, which the dialect does not have", question))
        else if point == "R" or point == "&" or isAsciiDigit(point) then
            Refused(fault("`(?" ++ point ++ "` is recursion, which the dialect does not have", question))
        else if (point == "+" or point == "-") and isAsciiDigit(next) then
            Refused(fault("`(?" ++ point ++ next ++ "` is recursion, which the dialect does not have", question))
        else if isAsciiLetter(point) or point == "-" or point == ")" then
            match readFlags(text, at, opening, open, flags)
                Read((result, close, True)) => Read(OpenedSetting(result, close + 1))
                Read((result, close, False)) => Read(OpenedGroup(result, close + 1))
                Refused(error) => Refused(error)
        else
            Refused(generic)

// ---------------------------------------------------------------------------
// Sequences

let sequenceOf(pieces: Vector(Piece)): Expr =
    var parts: Vector(Expr) = []
    for piece in pieces
        let isSetting = match piece.kind
            Setting(_) => True
            _ => False
        if not isSetting then parts := parts.append(piece.expr)
    match parts
        [] => Empty
        [only] => only
        _ => Concat(parts)

let alternationOf(branches: Vector(Expr)): Expr = match branches
    [only] => only
    _ => Alternate(branches)

let productOf(pieces: Vector(Piece)): Int =
    var largest = 1
    for piece in pieces
        if piece.product > largest then largest := piece.product
    largest

let literalOf(point: Int, flags: Flags): Expr =
    if flags.folded then Class([Range(point, point)], False, True) else Literal(point)

let atom(expr: Expr, start: Int): Piece = Piece({ expr = expr, kind = Atom, start = start, product = 1 })

let frameOf(opening: Int, capture: Option(Int), name: Option(String), saved: Flags): Frame =
    Frame({
        opening = opening,
        capture = capture,
        name = name,
        saved = saved,
        branches = [],
        pieces = [],
        product = 1,
    })

let withPiece(frames: Vector(Frame), piece: Piece): Vector(Frame) =
    let depth = Vector.length(frames)
    let top = frames[depth]
    Vector.set(frames, depth, { top with pieces = top.pieces.append(piece) })

// A quantifier's text written to match itself: `*?` as `\*\?`, `{3}` as `\{3}`.
let literalSpelling(written: String): String =
    var chunks: Vector(String) = []
    for point in written
        chunks := chunks.append(if point == "*" or point == "+" or point == "?" or point == "{" then "\\" ++ point else point)
    String.join(Iterable.toSeq(chunks), "")

// Whether `expr` holds a capturing group: a copy of it would be a second group,
// and every later group's number would move. Walked with an explicit stack, as
// the parser reads, so that a deep tree costs data and no host stack.
let holdsCapture(expr: Expr): Bool =
    var pending: Vector(Expr) = [expr]
    var found = False
    while not found and Vector.length(pending) > 0
        let next = pending[Vector.length(pending)]
        pending := Vector.dropLast(pending)
        match next
            Capture(_, _, _) => found := True
            Concat(parts) => pending := pending ++ parts
            Alternate(branches) => pending := pending ++ branches
            Repeat(body, _, _, _) => pending := pending.append(body)
            _ => ()
    found

// The count `{low,high}` past its bound on the atom written `atom`, as the
// sequence that matches what it would: whole runs of `{bound}`, then the rest,
// lazy where the count was. `bound` is the largest count the atom takes, 1000
// over the product of the counts inside it (§2.5). A count whose optional part
// would need two pieces prefers its runs in another order, so it has no such
// sequence; nor has a reversed count, nor one that would take more than
// `pieceLimit` pieces, whose counts `readDigits` may not have read whole, nor
// one whose atoms would run past `sequenceLimit` codepoints.
let countSequence(atom: String, low: Int, high: Option(Int), lazy: Bool, bound: Int): Option(String) =
    let runs = if low > 0 then Int.div(low - 1, bound) else 0
    let rest = low - runs * bound
    let reversed = match high
        Some(value) => value < low
        None => False
    let long = runs >= pieceLimit or (runs + 1) * String.length(atom) > sequenceLimit
    let last = if reversed or long then
        None
    else
        match high
            None => Some("{${rest},}")
            Some(value) =>
                let restHigh = value - runs * bound
                if restHigh > bound then None
                else if restHigh == rest then Some("{${rest}}")
                else Some("{${rest},${restHigh}}")
    match last
        None => None
        Some(count) =>
            var chunks: Vector(String) = []
            var run = 0
            while run < runs
                chunks := chunks.append(atom ++ "{${bound}}")
                run := run + 1
            chunks := chunks.append(atom ++ count ++ (if lazy then "?" else ""))
            Some(String.join(Iterable.toSeq(chunks), ""))

// The quantifier `written`, from `position` up to `after`, with nothing before
// it to repeat, for the `reason` the piece before it gives: refused, with the
// quantifier's literal spelling as its rewrite.
let nothingToRepeat(written: String, reason: String, position: Int, after: Int): Refusal =
    let spelled = literalSpelling(written)
    let rewrite = writing("write `" ++ spelled ++ "` for a literal `" ++ written ++ "`", position, after, spelled)
    fixed("nothing to repeat before `" ++ written ++ "`" ++ reason ++ "; write `" ++ spelled ++ "` for a literal `" ++ written ++ "`", position, [rewrite])

// A counted repetition as written: its counts, whether it is lazy, and the span
// from its `{` up to the codepoint after it.
record Counted = { low: Int, high: Option(Int), lazy: Bool, start: Int, after: Int }

// A count past its bound on the piece `last`, refused with `message` and, where
// no group in the atom would be written twice, the rewrite `title` names: a
// sequence of runs that keeps the product of the counts inside the bound.
let pastBound(pattern: String, last: Piece, counted: Counted, message: String, title: String): Refusal =
    let sequence = if holdsCapture(last.expr) then
        None
    else
        let written = slice(pattern, last.start, counted.start - 1)
        countSequence(written, counted.low, counted.high, counted.lazy, Int.div(limit, last.product))
    match sequence
        Some(spelled) => fixed(message, counted.start, [writing(title, last.start, counted.after, spelled)])
        None => fault(message, counted.start)

// The quantifier at `position` applied to the last piece of the top frame.
let quantify(
    pattern: String,
    text: Vector(String),
    frames: Vector(Frame),
    position: Int,
    flags: Flags,
): Outcome((Vector(Frame), Int), Refusal) =
    let size = Vector.length(text)
    let point = text[position]
    let counted = if point == "{" then
        readCount(text, position)
    else if point == "*" then
        Read((0, None, position + 1))
    else if point == "+" then
        Read((1, None, position + 1))
    else
        Read((0, Some(1), position + 1))
    match counted
        Refused(error) => Refused(error)
        Read((low, high, afterCount)) =>
            let lazyAt = skipIgnored(text, afterCount, flags.extended)
            let lazy = lazyAt <= size and text[lazyAt] == "?"
            let after = if lazy then lazyAt + 1 else afterCount
            let written = slice(pattern, position, after - 1)
            let depth = Vector.length(frames)
            let top = frames[depth]
            let count = Vector.length(top.pieces)
            if count == 0 then
                Refused(nothingToRepeat(written, "", position, after))
            else
                let last = top.pieces[count]
                match last.kind
                    Asserted(assertion) =>
                        Refused(nothingToRepeat(written, "; `" ++ assertion ++ "` is an assertion, not an atom", position, after))
                    Setting(setting) =>
                        Refused(nothingToRepeat(written, "; `" ++ setting ++ "` sets flags, not an atom", position, after))
                    Quantified(previous) =>
                        // A group around the repetition, one that captures nothing,
                        // so that no later group's number moves.
                        let repeated = slice(pattern, last.start, position - 1)
                        let nested = "write `(?:" ++ repeated ++ ")" ++ written ++ "`"
                        let wrapped = Rewrite({
                            title = quoted(nested),
                            edits = [edit(last.start, last.start, "(?:"), edit(position, position, ")")],
                        })
                        let previousLazy = String.length(previous) > 1 and String.endsWith(previous, "?")
                        // A possessive repetition never gives back what it took, so
                        // the group that repeats it is a guess at what was meant.
                        if written == "+" and not previousLazy then
                            Refused(fault("`" ++ previous ++ written ++ "` is possessive repetition, which the dialect does not have; to repeat a repetition, " ++ nested, position))
                        else
                            Refused(fixed("`" ++ previous ++ written ++ "` repeats a repetition; " ++ nested, position, [wrapped]))
                    Atom =>
                        let maximum = match high
                            Some(value) => value
                            None => low
                        if point == "{" and (low > limit or maximum > limit) then
                            let message = "repetition count exceeds 1000; write a longer run as a sequence, such as `x{1000}x{500}` for `x{1500}`"
                            Refused(pastBound(pattern, last, Counted({ low = low, high = high, lazy = lazy, start = position, after = after }), message, "write the run as a sequence"))
                        else if low > maximum then
                            let swapped = "{${maximum},${low}}"
                            let rewrite = writing("write `" ++ swapped ++ "`", position, afterCount, swapped)
                            Refused(fixed("`" ++ slice(pattern, position, afterCount - 1) ++ "` has a minimum above its maximum; write `" ++ swapped ++ "`", position, [rewrite]))
                        else
                            let factor = if point == "{" and maximum > 1 then maximum else 1
                            let product = factor * last.product
                            if product > limit then
                                let message = "nested repetition counts multiply past 1000; write the outer repetition as a sequence, such as `(?:x{100}){10}(?:x{100}){10}` for `(?:x{100}){20}`"
                                Refused(pastBound(pattern, last, Counted({ low = low, high = high, lazy = lazy, start = position, after = after }), message, "write the outer repetition as a sequence"))
                            else
                                let repeated = Piece({
                                    expr = Repeat(last.expr, low, high, not lazy),
                                    kind = Quantified(written),
                                    start = last.start,
                                    product = product,
                                })
                                let pieces = Vector.set(top.pieces, count, repeated)
                                Read((Vector.set(frames, depth, { top with pieces = pieces }), after))

// ---------------------------------------------------------------------------
// The parser

let parseText(pattern: String, text: Vector(String)): Outcome(Pattern, Refusal) =
    let size = Vector.length(text)
    var frames: Vector(Frame) = [frameOf(0, None, None, noFlags)]
    var flags = noFlags
    var count = 0
    var names: Map(String, Int) = Map.empty
    var position = 1
    var failure: Option(Refusal) = None
    var reading = True
    while reading
        position := skipIgnored(text, position, flags.extended)
        if position > size then
            reading := False
        else
            let point = text[position]
            let depth = Vector.length(frames)
            let top = frames[depth]
            if point == "|" then
                let finished = top.branches.append(sequenceOf(top.pieces))
                let product = if productOf(top.pieces) > top.product then productOf(top.pieces) else top.product
                frames := Vector.set(frames, depth, { top with branches = finished, pieces = [], product = product })
                position := position + 1
            else if point == ")" then
                if depth == 1 then
                    let rewrite = writing("write `\\)` for a literal `)`", position, position + 1, "\\)")
                    failure := Some(fixed("unmatched `)`; write `\\)` for a literal", position, [rewrite]))
                    reading := False
                else
                    let body = alternationOf(top.branches.append(sequenceOf(top.pieces)))
                    let product = if productOf(top.pieces) > top.product then productOf(top.pieces) else top.product
                    let group = match top.capture
                        Some(index) => Capture(body, index, top.name)
                        None => body
                    flags := top.saved
                    let piece = Piece({ expr = group, kind = Atom, start = top.opening, product = product })
                    frames := withPiece(Vector.dropLast(frames), piece)
                    position := position + 1
            else if point == "(" then
                // A flag setting opens no group, so only a group is held to the
                // nesting bound; past it, the opening is the fault whatever its
                // prefix would have said.
                let opened = if position + 1 <= size and text[position + 1] == "?" then
                    readPrefix(pattern, text, position, depth, flags)
                else
                    Read(OpenedGroup(flags, position + 1))
                let isSetting = match opened
                    Read(OpenedSetting(_, _)) => True
                    _ => False
                let isCapture = not (position + 1 <= size and text[position + 1] == "?")
                if depth > limit and not isSetting then
                    failure := Some(fault("nesting deeper than 1000", position))
                    reading := False
                else if isCapture then
                    count := count + 1
                    frames := frames.append(frameOf(position, Some(count), None, flags))
                    position := position + 1
                else
                    match opened
                        Refused(error) =>
                            failure := Some(error)
                            reading := False
                        Read(OpenedGroup(inner, next)) =>
                            frames := frames.append(frameOf(position, None, None, flags))
                            flags := inner
                            position := next
                        Read(OpenedSetting(inner, next)) =>
                            let setting = Piece({
                                expr = Empty,
                                kind = Setting(slice(pattern, position, next - 1)),
                                start = position,
                                product = 1,
                            })
                            frames := withPiece(frames, setting)
                            flags := inner
                            position := next
                        Read(OpenedNamed(name, nameAt, next)) =>
                            if Map.containsKey(names, name) then
                                failure := Some(fault("group `" ++ name ++ "` is already defined; give this group another name", nameAt))
                                reading := False
                            else
                                count := count + 1
                                names := Map.set(names, name, count)
                                frames := frames.append(frameOf(position, Some(count), Some(name), flags))
                                position := next
            else if isQuantifier(point) then
                match quantify(pattern, text, frames, position, flags)
                    Refused(error) =>
                        failure := Some(error)
                        reading := False
                    Read((updated, next)) =>
                        frames := updated
                        position := next
            else if point == "[" then
                match readClass(pattern, text, position, flags.folded)
                    Refused(error) =>
                        failure := Some(error)
                        reading := False
                    Read((expr, next)) =>
                        frames := withPiece(frames, atom(expr, position))
                        position := next
            else if point == "\\" then
                match readEscape(pattern, text, position)
                    Refused(error) =>
                        failure := Some(error)
                        reading := False
                    Read((EscapedPoint(value), next)) =>
                        frames := withPiece(frames, atom(literalOf(value, flags), position))
                        position := next
                    Read((EscapedItems(items, negated), next)) =>
                        frames := withPiece(frames, atom(Class(items, negated, flags.folded), position))
                        position := next
                    Read((EscapedAnchor(kind, written), next)) =>
                        let piece = Piece({ expr = Anchor(kind), kind = Asserted(written), start = position, product = 1 })
                        frames := withPiece(frames, piece)
                        position := next
            else if point == "^" or point == "$" then
                let kind = if point == "^" then
                    if flags.multiLine then LineStart else TextStart
                else
                    if flags.multiLine then LineEnd else TextEnd
                let piece = Piece({ expr = Anchor(kind), kind = Asserted(point), start = position, product = 1 })
                frames := withPiece(frames, piece)
                position := position + 1
            else if point == "." then
                frames := withPiece(frames, atom(Dot(flags.dotAll), position))
                position := position + 1
            else
                frames := withPiece(frames, atom(literalOf(codeOf(point), flags), position))
                position := position + 1
    match failure
        Some(error) => Refused(error)
        None =>
            let depth = Vector.length(frames)
            let top = frames[depth]
            if depth > 1 then
                // Every open group closed at the end; on a line of its own under
                // `x`, where the end may sit inside a comment.
                let newline = if flags.extended then "\n" else ""
                Refused(unclosedGroup(frames[2].opening, size, newline ++ closingParens(depth - 1)))
            else
                let root = alternationOf(top.branches.append(sequenceOf(top.pieces)))
                Read(Pattern({ root = root, groupCount = count, names = names }))

(** Parses `pattern` as the dialect of `spec/regex.md` §2: the tree. A pattern
    the dialect refuses throws `RegexError` for the first defect in reading
    order. *)
export let parse(pattern: String): Pattern = match parseText(pattern, points(pattern))
    Read(parsed) => parsed
    Refused(refusal) => throw^(RegexError(refusal.message, refusal.position, refusal.rewrites))
