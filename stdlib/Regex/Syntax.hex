module Regex.Syntax

// The parser of the regular-expression dialect and its public syntax tree
// (`spec/regex.md` §2, §5). This module is ordinary pure Hexagon with no door
// rows: the parser, the tree, the admitted property names, and the explicit
// ranges a class writes are all expressible here. What needs the Unicode tables
// — a property's codepoints, the folding of a class, every complement — is the
// engine's (`Hex.Runtime.Regex`, §6.1), so the tree carries a property by name
// and a fold by a flag.
//
// The tree is public so that the compiler and the language server load the one
// parser `Regex.compile` runs (§8), and so that a program can inspect a pattern.
//
// **The parser reads a pattern once, left to right, and stops at the first
// fault** (§2.9). It keeps its open groups on an explicit stack of frames rather
// than recursing, so a pattern nested to the dialect's bound of a thousand groups
// costs a thousand frames of data and no host stack.

// A pattern, as a tree. Flags are already resolved (§5): `m` chose the anchors,
// `s` set `Dot`'s `newline`, and `i` set `folded` on every class, a literal under
// it having become a one-range class. A non-capturing group is its body.
export union Expr =
    | Empty
    | Literal(point: Int)
    | Dot(newline: Bool)
    | Class(items: Vector(ClassItem), negated: Bool, folded: Bool)
    | Anchor(kind: AnchorKind)
    | Concat(parts: Vector(Expr))
    | Alternate(branches: Vector(Expr))
    | Repeat(body: Expr, min: Int, max: Option(Int), greedy: Bool)
    | Capture(body: Expr, index: Int, name: Option(String))

// One member of a class. The written ranges come first, sorted, disjoint and
// merged; the property items follow in written order. `negated` is set only on a
// complemented item written inside a class, as in `[\P{L}\d]`.
export union ClassItem =
    | Range(low: Int, high: Int)
    | Property(kind: PropertyKind, value: String, negated: Bool)

// Which table a property item names. `value` is the canonical spelling for the
// first four kinds and `""` for the rest, which the engine answers by kind alone.
// `Word` is Annex C's `\w`, the one kind with no `\p{…}` spelling.
export union PropertyKind = GeneralCategory | Script | ScriptExtensions | Binary | Any | Ascii | Assigned | Word

export union AnchorKind = TextStart | TextEnd | LineStart | LineEnd | WordBoundary | NotWordBoundary

// A parsed pattern: its tree, the number of capturing groups (group 0 not
// counted), and each group name's number.
export record Pattern = { root: Expr, groupCount: Int, names: Map(String, Int) }

// Why a pattern was refused: one sentence, and the 1-based codepoint position of
// the fault in the pattern — its length + 1 when the pattern ended early.
export record RegexError derives (Eq, Show) = { message: String, position: Int }

// The flags in force at a point in the pattern (§2.6).
record Flags = { folded: Bool, multiLine: Bool, dotAll: Bool, extended: Bool }

// What a piece of a sequence was, which decides what a quantifier after it may
// do (§2.5). An assertion and a flag setting carry their text for the message.
union PieceKind =
    | Atom
    | Asserted(text: String)
    | Setting(text: String)
    | Quantified(text: String)

// One piece of a sequence: its tree, what it was, where it began, and the
// product of the counted repetitions nested in it (§2.5's bound).
record Piece = { expr: Expr, kind: PieceKind, start: Int, product: Int }

// An open group. The top frame stands for the whole pattern and has no opening.
record Frame = {
    opening: Int,
    capture: Option(Int),
    name: Option(String),
    saved: Flags,
    branches: Vector(Expr),
    pieces: Vector(Piece),
    product: Int,
}

// What a backslash escape read (§2.3).
union Escaped =
    | EscapedPoint(point: Int)
    | EscapedItems(items: Vector(ClassItem), negated: Bool)
    | EscapedAnchor(kind: AnchorKind, text: String)

// What a `(?` prefix opened (§2.6).
union Opened =
    | OpenedGroup(flags: Flags, next: Int)
    | OpenedNamed(name: String, nameAt: Int, next: Int)
    | OpenedSetting(flags: Flags, next: Int)

// One member read inside a class.
union Member =
    | Single(point: Int)
    | Several(items: Vector(ClassItem))

let limit: Int = 1000

let noFlags: Flags = Flags({ folded = False, multiLine = False, dotAll = False, extended = False })

let fault(message: String, position: Int): RegexError =
    RegexError({ message = message, position = position })

// ---------------------------------------------------------------------------
// Codepoints

// The pattern's codepoints, each a one-codepoint `String`, so that positions are
// indexes.
let points(pattern: String): Vector(String) = Vector.fromSeq(Iterable.toSeq(pattern))

let codeOf(point: String): Int = match String.toCodepoint(point)
    Some(value) => value
    None => -1

let isAsciiLetter(point: String): Bool =
    let code = codeOf(point)
    (code >= 65 and code <= 90) or (code >= 97 and code <= 122)

let isAsciiDigit(point: String): Bool =
    let code = codeOf(point)
    code >= 48 and code <= 57

let digitValue(point: String): Int = codeOf(point) - 48

let hexValue(point: String): Option(Int) =
    let code = codeOf(point)
    if code >= 48 and code <= 57 then
        Some(code - 48)
    else if code >= 65 and code <= 70 then
        Some(code - 55)
    else if code >= 97 and code <= 102 then
        Some(code - 87)
    else
        None

let isWhiteSpace(point: String): Bool = String.trim(point) == ""

let isNameStart(point: String): Bool = isAsciiLetter(point) or point == "_"

let isNameContinue(point: String): Bool = isNameStart(point) or isAsciiDigit(point)

let isValidName(name: String): Bool =
    var valid = name != ""
    var first = True
    for point in name
        if first then
            valid := valid and isNameStart(point)
            first := False
        else
            valid := valid and isNameContinue(point)
    valid

// The pattern's text from `start` to `end`, inclusive; `""` when empty.
let slice(pattern: String, start: Int, end: Int): String =
    if start > end then "" else pattern[start..end]

// The position after the run of ignored whitespace and comments at `position`
// under `x` (§2.6), or `position` itself without it. An escaped codepoint is
// never ignored, so the scan stops at a backslash.
let skipIgnored(text: Vector(String), position: Int, extended: Bool): Int =
    let size = Vector.length(text)
    var at = position
    var scanning = extended
    while scanning and at <= size
        let point = text[at]
        if isWhiteSpace(point) then
            at := at + 1
        else if point == "#" then
            at := at + 1
            var inComment = True
            while inComment and at <= size
                if text[at] == "\n" then inComment := False
                at := at + 1
        else
            scanning := False
    at

// ---------------------------------------------------------------------------
// Escapes (§2.3)

let refusedEscape(letter: String): Option(String) =
    if isAsciiDigit(letter) and letter != "0" then
        Some("`\\" ++ letter ++ "` is a backreference, which the dialect does not have")
    else
        match letter
            "0" => Some("`\\0` is not an escape; write `\\u{…}`")
            "x" => Some("`\\x` is not an escape; write `\\u{…}`")
            "f" => Some("`\\f` is not an escape; write `\\u{…}`")
            "v" => Some("`\\v` is not an escape; write `\\u{…}`")
            "a" => Some("`\\a` is not an escape; write `\\u{…}`")
            "e" => Some("`\\e` is not an escape; write `\\u{…}`")
            "Q" => Some("`\\Q` is not an escape; quote text with `Regex.escape`")
            "X" => Some("`\\X` is not an escape; the dialect has no grapheme atom")
            "R" => Some("`\\R` is not an escape; the dialect has no linebreak atom")
            "h" => Some("`\\h` is not an escape; the dialect has no horizontal-space atom")
            "C" => Some("`\\C` is not an escape; the dialect has no byte atom")
            "Z" => Some("`\\Z` is not an escape; write `\\z`, since the dialect has no before-final-newline anchor")
            _ => None

let perl(kind: PropertyKind, value: String, negated: Bool): Escaped =
    EscapedItems([Property(kind, value, False)], negated)

