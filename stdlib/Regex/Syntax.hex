    ("Other_Letter", "Lo"), ("Lt", "Lt"), ("Titlecase_Letter", "Lt"), ("Lu", "Lu"),
    ("Uppercase_Letter", "Lu"), ("M", "M"), ("Mark", "M"), ("Mc", "Mc"), ("Spacing_Mark", "Mc"),
    ("Me", "Me"), ("Enclosing_Mark", "Me"), ("Mn", "Mn"), ("Nonspacing_Mark", "Mn"), ("N", "N"),
    ("Number", "N"), ("Nd", "Nd"), ("Decimal_Number", "Nd"), ("Nl", "Nl"), ("Letter_Number", "Nl"),
    ("No", "No"), ("Other_Number", "No"), ("P", "P"), ("Punctuation", "P"), ("Pc", "Pc"),
    ("Connector_Punctuation", "Pc"), ("Pd", "Pd"), ("Dash_Punctuation", "Pd"), ("Pe", "Pe"),
    ("Close_Punctuation", "Pe"), ("Pf", "Pf"), ("Final_Punctuation", "Pf"), ("Pi", "Pi"),
