(** Raised when a division or remainder is asked for with a zero divisor, at any
    integer type. `message` names the operation that threw. *)
export exception DivideByZeroError(message: String)

(** The polymorphic face of exact integer division. Honoring `Integral` gives a
    type both division conventions — Euclidean `div`/`mod` and truncated
    `quot`/`rem` — along with greatest common divisors. *)
export constraint Integral<a: (Num, Ord)> =
    (** The Euclidean quotient of `left` divided by `right`. *)
    div(left: a, right: a): a
    (** The Euclidean remainder of `left` divided by `right`, always in
        `[0, abs(right))` whatever the signs. *)
    mod(left: a, right: a): a
    (** The truncated quotient of `left` divided by `right`, rounding toward
        zero. *)
    quot(left: a, right: a): a
    (** The truncated remainder of `left` divided by `right`, taking the sign of
        `left`. *)
    rem(left: a, right: a): a
    (** The greatest common divisor of `left` and `right`, never negative. *)
    gcd(left: a, right: a): a
