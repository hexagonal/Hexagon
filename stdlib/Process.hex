module Process

// The program's arguments and the status it reports when it finishes, under
// Node (`spec/program-io.md` section 5). The module is outside the prelude,
// reached by `import Process`.
//
// Node is reached through an ordinary `extern` block over `node:process`'s
// default export, the `process` object, so the playground can link its own
// stand-in beneath this module (section 6). Nothing here needs the intrinsic
// door.

(** Thrown by `setExitStatus` for a status outside 0 to 255, which Node would
    wrap: 256 would report success, and -1 would report 255. *)
export fault ExitStatusFault(status: Int)

extern from "node:process"
    type NodeProcess
    default let process: NodeProcess
    get argv(process: NodeProcess) ->~ Array(String)
    get execArgv(process: NodeProcess) ->~ Array(String)
    set exitCode(process: NodeProcess, status: Int) ->! Unit

// Whether Node ran code given on its command line, so that `argv`'s second
// element is the user's first argument rather than a script's path. Node keeps
// each option as it was typed: `-e`, `--eval`, `-p` and `--print` alone, or
// joined to their value (`--eval=…`), or among short options run together
// (`-pe`).
// Short options run together, such as `-pe`.
let isShortOptions(option: String): Bool =
    option.startsWith("-") and not option.startsWith("--")

let ranCommandLineCode(options: Array(String)): Bool =
    var found = False
    for option in options
        if option == "-e" or option == "--eval" or option == "-p" or option == "--print" then
            found := True
        else if option.startsWith("--eval=") or option.startsWith("--print=") then
            found := True
        else if isShortOptions(option) and (option.contains("e") or option.contains("p")) then
            found := True
    found

(** The arguments the user gave the program, in order, without Node's own
    options or the script's path: `node main.js input.txt` gives
    `["input.txt"]`. They are read from Node each time. *)
export let arguments(): Vector(String) =
    let skipped = if ranCommandLineCode(execArgv~(process)) then 1 else 2
    var result: Vector(String) = []
    var position = 0
    for argument in argv~(process)
        position := position + 1
        if position > skipped then result := result.append(argument)
    result

(** Sets the status the program reports when it finishes, from 0 to 255; it
    doesn't end the program, and the last setting wins. Any other status
    throws `ExitStatusFault`. *)
export let setExitStatus(status: Int): Unit =
    if status < 0 or status > 255 then throw(ExitStatusFault(status))
    assume exitCode!(process, status)
