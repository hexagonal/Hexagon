module Array

// The public companion of the captured foreign `Array(a)` (FFI Part 2
// section 6).
//
// `Array(a)` is compiler-owned: no `.hex` file declares it, because a value
// made at the boundary has no Hexagon declaration site, exactly as `JsValue`
// has none. This module is its companion by being the module
// addressable under the name (Method Syntax section 4.1), the same way
// `Vector.hex` is `Vector`'s and `JsValue.hex` is `JsValue`'s.
//
// Everything here is a **read of a value**: the array Hexagon holds is its own
// copy, made as the foreign array crossed, and no foreign code can reach it
// (section 6.2). There is no mutation surface and there will not be one: the
// collection is readonly from Hexagon, full stop, so there is nothing here to
// misuse and no diagnostic guarding an operation that does not exist
// (section 10).
//
// The whole minimal decode loop is three operations, and two of them are here:
// `length` says how far to go, `get` answers with `Option`, and the asserting
// read is the bracket `values[index]` — an expression form, so it is the
// emitter's own lowering rather than an export of this file, exactly as
// `Vector`'s bracket and `Map`'s are.
//
// Beside the loop sits `toVector`, which is not part of it: FFI Part 2
// section 9's conversion into a persistent vector.

extern from "hex:intrinsic"
    (** How many elements `values` holds. It is the captured array's own
        `length` — the source's length at the moment of capture, which never
        changes — read in constant time and without touching a single element:
        nothing here scans. *)
    export fun arrayLength as length(values: Array(a)) -> Int

(** The element at 1-based `index`, or `None` when there is none. The total
    accessor: out of bounds is an answer, not a fault. `values[index]` is its
    asserting sibling, which throws `IndexError` instead. *)
export let get(values: Array(a), index: Int): Option(a) =
    if index < 1 or index > length(values) then
        None
    else
        Some(values[index])

// FFI Part 2 section 9's conversion, and **not** a door row — which is the
// interesting half, because section 9's other direction is one. `Vector.toArray`
// is keyed because a source body could not name its own result: an `Array(a)`
// has no Hexagon producer at all, no literal and no constructor (section 6.1).
// Read the other way that argument fails. A captured array has no producer but
// it does have a traversal — section 8.1's provided `Iterable` row, which
// section 8.2 emits as native `for...of` — and a `Vector(a)` has the producer
// the result needs, `append`, in scope because this module is seated after
// `Vector.hex`. So the fold below is expressible at the same complexity and in
// the same emitted shape a key would have produced, and
// `spec/stdlib-roadmap.md` section 5.1 keeps such behaviour in Hexagon: none of
// its four grounds for a private intrinsic — a host capability, an opaque or
// performance-critical representation, a compiler transformation, measured
// performance evidence — reaches this operation.
//
// The loop is the whole contract. It is eager because it runs to completion
// before the value is returned; it is a persistent vector that shares no
// storage with the array it was read from; it is shallow because the values are
// moved, never rebuilt; it is total because an empty array takes zero steps.
// Section 6.4's holes need nothing written for them: the capture stored
// `undefined` wherever the source had a hole (section 6.2's dense copy), which
// is what `Nullable.undefined` is, so a once-sparse array yields its `length`
// elements with `undefined` in those places.

(** The elements of `values` collected into a vector, built at once. The
    conversion is shallow — an element that is itself a vector or a record
    arrives as that same value. *)
export let toVector(values: Array(a)): Vector(a) =
    var collected: Vector(a) = []
    for value in values
        collected := collected.append(value)
    collected
