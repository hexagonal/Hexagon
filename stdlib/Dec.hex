module Dec

(** Raised when an exact decimal operation would retain more decimal places
    than `Nat` can represent. *)
export exception DecimalPlacesOverflowError(message: String)

(** A finite decimal number, represented exactly by an integer coefficient and
    a retained count of decimal places. *)
opaque record Dec = {
    coefficient: BigInt,
    places: Nat,
}

let natAsInt(value: Nat): Int = Int.fromNat(value)
let intAsNat(value: Int): Nat = match Nat.fromInt(value)
    Some(natural) => natural
    None => 0
let tenToInt(value: Int): BigInt = 10n ** value
let tenTo(value: Nat): BigInt = tenToInt(natAsInt(value))

(** Constructs the exact decimal whose unscaled integer is `value` and which
    retains `decimalPlaces` digits after the decimal point. *)
export let create(value: BigInt, decimalPlaces: Nat): Dec =
    Dec({coefficient = value, places = decimalPlaces})

(** The unscaled integer stored by `decimal`. *)
export let value(decimal: Dec): BigInt = decimal.coefficient

(** The number of decimal places retained by `decimal`. *)
export let decimalPlaces(decimal: Dec): Nat = decimal.places

let align(value: Dec, places: Nat): BigInt =
    value.coefficient * tenToInt(natAsInt(places) - natAsInt(value.places))

let roundedMagnitude(numerator: BigInt, denominator: BigInt, even: Bool): BigInt =
    let quotient = numerator.quot(denominator)
    let twiceRemainder = numerator.rem(denominator) * 2
    if twiceRemainder > denominator then
        quotient + 1
    else if twiceRemainder < denominator then
        quotient
    else if even and quotient.rem(2) == 0 then
        quotient
    else
        quotient + 1

let roundedRatio(numerator: BigInt, denominator: BigInt, even: Bool): BigInt =
    let negative = (numerator < 0 and denominator > 0) or
        (numerator > 0 and denominator < 0)
    let top = numerator.abs()
    let bottom = denominator.abs()
    let rounded = roundedMagnitude(top, bottom, even)
    if negative then -rounded else rounded

let changedPlaces(decimal: Dec, requested: Nat, even: Bool): Dec =
    if decimal.coefficient == 0 then
        create(0n, requested)
    else if requested >= decimal.places then
        create(
            decimal.coefficient * tenToInt(natAsInt(requested) - natAsInt(decimal.places)),
            requested
        )
    else
        create(
            roundedRatio(
                decimal.coefficient,
                tenToInt(natAsInt(decimal.places) - natAsInt(requested)),
                even
            ),
            requested
        )

(** Returns `decimal` with exactly `requested` decimal places, rounding nearest
    with ties away from zero when places are removed. *)
export let withDecimalPlaces(decimal: Dec, requested: Nat): Dec =
    changedPlaces(decimal, requested, False)

(** Returns `decimal` with exactly `requested` decimal places, rounding nearest
    with ties to even when places are removed. *)
export let withDecimalPlacesEven(decimal: Dec, requested: Nat): Dec =
    changedPlaces(decimal, requested, True)

let multipliedTo(left: Dec, right: Dec, requested: Nat, even: Bool): Dec =
    let product = left.coefficient * right.coefficient
    // Cancel the requested places before constructing a power. Every exponent
    // stays in Nat even when the hypothetical exact result's place sum would
    // exceed Nat.
    if product == 0 then
        create(0n, requested)
    else if requested >= left.places then
        let remaining = natAsInt(requested) - natAsInt(left.places)
        if remaining >= natAsInt(right.places) then
            create(product * tenToInt(remaining - natAsInt(right.places)), requested)
        else
            create(roundedRatio(product, tenToInt(natAsInt(right.places) - remaining), even), requested)
    else
        let divisor = tenToInt(natAsInt(left.places) - natAsInt(requested)) * tenTo(right.places)
        create(roundedRatio(product, divisor, even), requested)

(** The exact product rounded to `requested` places, ties away from zero. *)
export let multiplyTo(left: Dec, right: Dec, requested: Nat): Dec =
    multipliedTo(left, right, requested, False)

(** The exact product rounded to `requested` places, ties to even. *)
export let multiplyToEven(left: Dec, right: Dec, requested: Nat): Dec =
    multipliedTo(left, right, requested, True)

let dividedTo(left: Dec, right: Dec, requested: Nat, even: Bool, operation: String): Dec =
    if right.coefficient == 0 then
        throw(DivideByZeroError("${operation}: divisor is zero"))
    else if left.coefficient == 0 then
        create(0n, requested)
    else
        // Cancel the operands' places first. Applying the requested result
        // scale as a separate exact factor avoids an overflowing scale sum.
        if right.places >= left.places then
            let numerator = left.coefficient *
                tenToInt(natAsInt(right.places) - natAsInt(left.places)) * tenTo(requested)
            create(roundedRatio(numerator, right.coefficient, even), requested)
        else
            let numerator = left.coefficient * tenTo(requested)
            let denominator = right.coefficient *
                tenToInt(natAsInt(left.places) - natAsInt(right.places))
            create(roundedRatio(numerator, denominator, even), requested)

(** The exact quotient rounded to `requested` places, ties away from zero. *)
export let divideTo(left: Dec, right: Dec, requested: Nat): Dec =
    dividedTo(left, right, requested, False, "Dec.divideTo")

(** The exact quotient rounded to `requested` places, ties to even. *)
export let divideToEven(left: Dec, right: Dec, requested: Nat): Dec =
    dividedTo(left, right, requested, True, "Dec.divideToEven")

(** `decimal` rounded to an integer, nearest with ties away from zero. *)
export let round(decimal: Dec): BigInt =
    if decimal.coefficient == 0 then 0n
    else roundedRatio(decimal.coefficient, tenTo(decimal.places), False)

(** `decimal` rounded to an integer, nearest with ties to even. *)
export let roundEven(decimal: Dec): BigInt =
    if decimal.coefficient == 0 then 0n
    else roundedRatio(decimal.coefficient, tenTo(decimal.places), True)

(** `decimal` rounded toward zero. *)
export let trunc(decimal: Dec): BigInt =
    if decimal.coefficient == 0 then 0n
    else decimal.coefficient.quot(tenTo(decimal.places))

(** The greatest integer no greater than `decimal`. *)
export let floor(decimal: Dec): BigInt =
    if decimal.coefficient == 0 then 0n
    else
        let divisor = tenTo(decimal.places)
        let truncated = decimal.coefficient.quot(divisor)
        if decimal.coefficient < 0 and decimal.coefficient.rem(divisor) != 0 then
            truncated - 1
        else
            truncated

(** The least integer no less than `decimal`. *)
export let ceil(decimal: Dec): BigInt =
    if decimal.coefficient == 0 then 0n
    else
        let divisor = tenTo(decimal.places)
        let truncated = decimal.coefficient.quot(divisor)
        if decimal.coefficient > 0 and decimal.coefficient.rem(divisor) != 0 then
            truncated + 1
        else
            truncated

honor Num<Dec> =
    add(left, right) =
        let places = if left.places > right.places then left.places else right.places
        create(align(left, places) + align(right, places), places)

    multiply(left, right) =
        let limit: Int = 9_007_199_254_740_991
        let leftPlaces = natAsInt(left.places)
        let rightPlaces = natAsInt(right.places)
        if leftPlaces > limit - rightPlaces then
            throw(DecimalPlacesOverflowError("Dec.multiply: decimal places overflow"))
        else
            create(left.coefficient * right.coefficient, intAsNat(leftPlaces + rightPlaces))

    fromNat(value) = FromBigInt.fromBigInt(BigInt.fromNat(value))

honor Signed<Dec> =
    subtract(left, right) =
        let places = if left.places > right.places then left.places else right.places
        create(align(left, places) - align(right, places), places)

    negate(decimal) = create(-decimal.coefficient, decimal.places)
    fromInt(value) = FromBigInt.fromBigInt(BigInt.fromInt(value))

honor FromBigInt<Dec> =
    fromBigInt(value) = create(value, 0)

honor Eq<Dec> =
    equals(left, right) =
        if left.coefficient == 0 then
            right.coefficient == 0
        else if right.coefficient == 0 then
            False
        else if left.places >= right.places then
            left.coefficient == right.coefficient *
                tenToInt(natAsInt(left.places) - natAsInt(right.places))
        else
            left.coefficient * tenToInt(natAsInt(right.places) - natAsInt(left.places)) ==
                right.coefficient

honor Ord<Dec> =
    compare(left, right) =
        if left.coefficient == 0 and right.coefficient == 0 then
            Ordering.Equal
        else if left.coefficient == 0 then
            if right.coefficient < 0 then Ordering.Greater else Ordering.Less
        else if right.coefficient == 0 then
            if left.coefficient < 0 then Ordering.Less else Ordering.Greater
        else if left.coefficient < 0 and right.coefficient > 0 then
            Ordering.Less
        else if left.coefficient > 0 and right.coefficient < 0 then
            Ordering.Greater
        else
            let places = if left.places > right.places then left.places else right.places
            let leftValue = align(left, places)
            let rightValue = align(right, places)
            if leftValue < rightValue then
                Ordering.Less
            else if leftValue > rightValue then
                Ordering.Greater
            else
                Ordering.Equal

let canonicalCoefficient(decimal: Dec): BigInt =
    if decimal.coefficient == 0 then 0n
    else
        var coefficient = decimal.coefficient
        var places = decimal.places
        while places > 0 and coefficient.rem(10) == 0
            coefficient := coefficient.quot(10)
            places := intAsNat(natAsInt(places) - 1)
        coefficient

// A coefficient-only hash deliberately permits collisions between unequal
// scales, while canonicalization guarantees equal decimals hash equally.
honor Hash<Dec> =
    hash(decimal) = canonicalCoefficient(decimal).hash()

honor Real<Dec> =
    abs(decimal) = if decimal.coefficient < 0 then -decimal else decimal

    sign(decimal) =
        if decimal.coefficient == 0 then
            Sign.Zero
        else if decimal.coefficient < 0 then
            Sign.Negative
        else
            Sign.Positive

honor Pow<Dec> =
    pow(decimal, exponent) =
        if exponent < 0 then
            throw(NegativeExponentError("Dec.pow: exponent cannot be negative"))
        else if exponent == 0 then
            create(1n, 0)
        else
            let limit: Int = 9_007_199_254_740_991
            let places = natAsInt(decimal.places)
            if places > 0 and exponent > limit.quot(places) then
                throw(DecimalPlacesOverflowError("Dec.pow: decimal places overflow"))
            else
                create(decimal.coefficient ** exponent, intAsNat(places * exponent))

honor Show<Dec> =
    show(decimal) =
        let negative = decimal.coefficient < 0
        let digits = decimal.coefficient.abs().show()
        let places = natAsInt(decimal.places)
        let digitCount = digits.length()
        let rendered =
            if places == 0 then
                digits
            else if digitCount > places then
                "${digits.dropLastN(places)}.${digits.dropFirstN(digitCount - places)}"
            else
                var zeroes = ""
                var count = places - digitCount
                while count > 0
                    zeroes := "${zeroes}0"
                    count := count - 1
                "0.${zeroes}${digits}"
        if negative and decimal.coefficient != 0 then "-${rendered}" else rendered

// The exact binary64 conversion is shared in shape with `Rat.toFloat`: compute
// the correctly rounded significand using integers, then assemble one Float.
let bitLength(value: BigInt): Int =
    var high: Int = 1
    while (2 ** high) <= value
        high := high * 2
    var low: Int = if high == 1 then 0 else high.quot(2)
    while high - low > 1
        let middle = (low + high).quot(2)
        if (2 ** middle) <= value then low := middle else high := middle
    high

let scaledTop(value: BigInt, scale: Int): BigInt =
    if scale > 0 then value * (2 ** scale) else value

let scaledBottom(value: BigInt, scale: Int): BigInt =
    if scale < 0 then value * (2 ** (-scale)) else value

let alignedScale(numerator: BigInt, denominator: BigInt): Int =
    let guess = 53 - (bitLength(numerator) - bitLength(denominator))
    let raw = scaledTop(numerator, guess).quot(scaledBottom(denominator, guess))
    if raw >= (2 ** 53) then guess - 1 else guess

let roundedSignificand(numerator: BigInt, denominator: BigInt, scale: Int): BigInt =
    let dividend = scaledTop(numerator, scale)
    let divisor = scaledBottom(denominator, scale)
    roundedMagnitude(dividend, divisor, True)

let powerOfTwo(exponent: Int): Float = (2n ** exponent).toFloat()

let assemble(significand: BigInt, scale: Int): Float =
    let result = significand.toFloat()
    if scale >= 0 then
        let half = scale.quot(2)
        result / powerOfTwo(half) / powerOfTwo(scale - half)
    else
        let magnitude = -scale
        let half = magnitude.quot(2)
        result * powerOfTwo(half) * powerOfTwo(magnitude - half)

(** `decimal` as the nearest `Float`, rounded once with ties to even. *)
export let toFloat(decimal: Dec): Float =
    if decimal.coefficient == 0 then
        0.0
    else
        let negative = decimal.coefficient < 0
        let numerator = decimal.coefficient.abs()
        let denominator = tenTo(decimal.places)
        let aligned = alignedScale(numerator, denominator)
        let scale = if aligned > 1074 then 1074 else aligned
        let significand = roundedSignificand(numerator, denominator, scale)
        let carried = significand == (2 ** 53)
        let bits = if carried then 2 ** 52 else significand
        let exponent = if carried then scale - 1 else scale
        if bits == 0 or exponent < -971 then
            throw(FloatRangeError("Dec.toFloat: value does not fit in Float"))
        else
            let result = assemble(bits, exponent)
            if negative then -result else result
