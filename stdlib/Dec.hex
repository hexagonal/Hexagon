module Dec

(** Raised when a decimal operation is asked to retain negative decimal places. *)
export exception NegativeDecimalPlacesError(message: String)

(** Raised when an exact decimal operation would retain more decimal places
    than `Int` can represent. *)
export exception DecimalPlacesOverflowError(message: String)

(** A finite decimal number, represented exactly by an integer coefficient and
    a retained count of decimal places. *)
opaque record Dec = {
    unscaled: BigInt,
    places: Int,
}

let tenTo(value: Int): BigInt = 10n ** value

let requirePlaces(places: Int, operation: String): Int =
    if places < 0 then
        throw(NegativeDecimalPlacesError("${operation}: decimal places cannot be negative"))
    else
        places

(** Constructs the exact decimal whose unscaled integer is `unscaled` and which
    retains `places` digits after the decimal point. *)
export let create(unscaled: BigInt, places: Int): Dec =
    Dec({unscaled, places = requirePlaces(places, "Dec.create")})

(** The unscaled integer stored by `decimal`. *)
export let unscaled(decimal: Dec): BigInt = decimal.unscaled

(** Whether `left` and `right` store the same exact unscaled integer and retain
    the same number of decimal places. This compares representations, not object
    identity; numerical equality remains independent of retained places. *)
export let same(left: Dec, right: Dec): Bool =
    left.unscaled == right.unscaled and left.places == right.places

let align(value: Dec, retained: Int): BigInt =
    value.unscaled * tenTo(retained - value.places)

let roundedMagnitude(numerator: BigInt, denominator: BigInt, even: Bool): BigInt =
    let quotient = numerator.quot(denominator)
    let twiceRemainder = numerator.rem(denominator) * 2
    if twiceRemainder > denominator then
        quotient + 1
    else if twiceRemainder < denominator then
        quotient
    else if even and quotient.rem(2) == 0 then
        quotient
    else
        quotient + 1

let roundedRatio(numerator: BigInt, denominator: BigInt, even: Bool): BigInt =
    let negative = (numerator < 0 and denominator > 0) or
        (numerator > 0 and denominator < 0)
    let top = numerator.abs()
    let bottom = denominator.abs()
    let rounded = roundedMagnitude(top, bottom, even)
    if negative then -rounded else rounded

let changedPlaces(decimal: Dec, requested: Int, even: Bool, operation: String): Dec =
    let checked = requirePlaces(requested, operation)
    if decimal.unscaled == 0 then
        create(0n, checked)
    else if checked >= decimal.places then
        create(
            decimal.unscaled * tenTo(checked - decimal.places),
            checked
        )
    else
        create(
            roundedRatio(
                decimal.unscaled,
                tenTo(decimal.places - checked),
                even
            ),
            checked
        )

(** Returns `decimal` with exactly `places` decimal places, rounding nearest
    with ties away from zero when places are removed. *)
export let withPlaces(decimal: Dec, places: Int): Dec =
    changedPlaces(decimal, places, False, "Dec.withPlaces")

(** Returns `decimal` with exactly `places` decimal places, rounding nearest
    with ties to even when places are removed. *)
export let withPlacesEven(decimal: Dec, places: Int): Dec =
    changedPlaces(decimal, places, True, "Dec.withPlacesEven")

let divided(left: Dec, right: Dec, requested: Int, even: Bool, operation: String): Dec =
    let checked = requirePlaces(requested, operation)
    if right.unscaled == 0 then
        throw(DivideByZeroError("${operation}: divisor is zero"))
    else if left.unscaled == 0 then
        create(0n, checked)
    else
        // Cancel the operands' places first. Applying the requested result
        // scale as a separate exact factor avoids an overflowing scale sum.
        if right.places >= left.places then
            let numerator = left.unscaled * tenTo(right.places - left.places) * tenTo(checked)
            create(roundedRatio(numerator, right.unscaled, even), checked)
        else
            let numerator = left.unscaled * tenTo(checked)
            let denominator = right.unscaled * tenTo(left.places - right.places)
            create(roundedRatio(numerator, denominator, even), checked)

(** The exact quotient rounded to `places` places, ties away from zero. *)
export let divide(left: Dec, right: Dec, places: Int): Dec =
    divided(left, right, places, False, "Dec.divide")

(** The exact quotient rounded to `places` places, ties to even. *)
export let divideEven(left: Dec, right: Dec, places: Int): Dec =
    divided(left, right, places, True, "Dec.divideEven")

(** `decimal` rounded to an integer, nearest with ties away from zero. *)
export let round(decimal: Dec): BigInt =
    if decimal.unscaled == 0 then 0n
    else roundedRatio(decimal.unscaled, tenTo(decimal.places), False)

(** `decimal` rounded to an integer, nearest with ties to even. *)
export let roundEven(decimal: Dec): BigInt =
    if decimal.unscaled == 0 then 0n
    else roundedRatio(decimal.unscaled, tenTo(decimal.places), True)

(** `decimal` rounded toward zero. *)
export let trunc(decimal: Dec): BigInt =
    if decimal.unscaled == 0 then 0n
    else decimal.unscaled.quot(tenTo(decimal.places))

(** The greatest integer no greater than `decimal`. *)
export let floor(decimal: Dec): BigInt =
    if decimal.unscaled == 0 then 0n
    else
        let divisor = tenTo(decimal.places)
        let truncated = decimal.unscaled.quot(divisor)
        if decimal.unscaled < 0 and decimal.unscaled.rem(divisor) != 0 then
            truncated - 1
        else
            truncated

(** The least integer no less than `decimal`. *)
export let ceil(decimal: Dec): BigInt =
    if decimal.unscaled == 0 then 0n
    else
        let divisor = tenTo(decimal.places)
        let truncated = decimal.unscaled.quot(divisor)
        if decimal.unscaled > 0 and decimal.unscaled.rem(divisor) != 0 then
            truncated + 1
        else
            truncated

honor Num<Dec> =
    add(left, right) =
        let retained = if left.places > right.places then left.places else right.places
        create(align(left, retained) + align(right, retained), retained)

    multiply(left, right) =
        let limit: Int = 9_007_199_254_740_991
        if left.places > limit - right.places then
            throw(DecimalPlacesOverflowError("Dec.multiply: decimal places overflow"))
        else
            create(left.unscaled * right.unscaled, left.places + right.places)

    fromNat(value) = FromBigInt.fromBigInt(BigInt.fromNat(value))

honor Signed<Dec> =
    subtract(left, right) =
        let retained = if left.places > right.places then left.places else right.places
        create(align(left, retained) - align(right, retained), retained)

    negate(decimal) = create(-decimal.unscaled, decimal.places)
    fromInt(value) = FromBigInt.fromBigInt(BigInt.fromInt(value))

honor FromBigInt<Dec> =
    fromBigInt(value) = create(value, 0)

honor Eq<Dec> =
    equals(left, right) =
        if left.unscaled == 0 then
            right.unscaled == 0
        else if right.unscaled == 0 then
            False
        else if left.places >= right.places then
            left.unscaled == right.unscaled * tenTo(left.places - right.places)
        else
            left.unscaled * tenTo(right.places - left.places) == right.unscaled

honor Ord<Dec> =
    compare(left, right) =
        if left.unscaled == 0 and right.unscaled == 0 then
            Ordering.Equal
        else if left.unscaled == 0 then
            if right.unscaled < 0 then Ordering.Greater else Ordering.Less
        else if right.unscaled == 0 then
            if left.unscaled < 0 then Ordering.Less else Ordering.Greater
        else if left.unscaled < 0 and right.unscaled > 0 then
            Ordering.Less
        else if left.unscaled > 0 and right.unscaled < 0 then
            Ordering.Greater
        else
            let retained = if left.places > right.places then left.places else right.places
            let leftValue = align(left, retained)
            let rightValue = align(right, retained)
            if leftValue < rightValue then
                Ordering.Less
            else if leftValue > rightValue then
                Ordering.Greater
            else
                Ordering.Equal

let canonicalCoefficient(decimal: Dec): BigInt =
    if decimal.unscaled == 0 then 0n
    else
        var coefficient = decimal.unscaled
        var remainingPlaces = decimal.places
        while remainingPlaces > 0 and coefficient.rem(10) == 0
            coefficient := coefficient.quot(10)
            remainingPlaces := remainingPlaces - 1
        coefficient

// A coefficient-only hash deliberately permits collisions between unequal
// scales, while canonicalization guarantees equal decimals hash equally.
honor Hash<Dec> =
    hash(decimal) = canonicalCoefficient(decimal).hash()

honor Real<Dec> =
    abs(decimal) = if decimal.unscaled < 0 then -decimal else decimal

    sign(decimal) =
        if decimal.unscaled == 0 then
            Sign.Zero
        else if decimal.unscaled < 0 then
            Sign.Negative
        else
            Sign.Positive

honor Pow<Dec> =
    pow(decimal, exponent) =
        if exponent < 0 then
            throw(NegativeExponentError("Dec.pow: exponent cannot be negative"))
        else if exponent == 0 then
            create(1n, 0)
        else
            let limit: Int = 9_007_199_254_740_991
            let retained = decimal.places
            if retained > 0 and exponent > limit.quot(retained) then
                throw(DecimalPlacesOverflowError("Dec.pow: decimal places overflow"))
            else
                create(decimal.unscaled ** exponent, retained * exponent)

honor Show<Dec> =
    show(decimal) =
        let negative = decimal.unscaled < 0
        let digits = decimal.unscaled.abs().show()
        let retained = decimal.places
        let digitCount = digits.length()
        let rendered =
            if retained == 0 then
                digits
            else if digitCount > retained then
                "${digits.dropLastN(retained)}.${digits.dropFirstN(digitCount - retained)}"
            else
                var zeroes = ""
                var count = retained - digitCount
                while count > 0
                    zeroes := "${zeroes}0"
                    count := count - 1
                "0.${zeroes}${digits}"
        if negative and decimal.unscaled != 0 then "-${rendered}" else rendered

// The exact binary64 conversion is shared in shape with `Rat.toFloat`: compute
// the correctly rounded significand using integers, then assemble one Float.
let bitLength(value: BigInt): Int =
    var high: Int = 1
    while (2 ** high) <= value
        high := high * 2
    var low: Int = if high == 1 then 0 else high.quot(2)
    while high - low > 1
        let middle = (low + high).quot(2)
        if (2 ** middle) <= value then low := middle else high := middle
    high

let scaledTop(value: BigInt, scale: Int): BigInt =
    if scale > 0 then value * (2 ** scale) else value

let scaledBottom(value: BigInt, scale: Int): BigInt =
    if scale < 0 then value * (2 ** (-scale)) else value

let alignedScale(numerator: BigInt, denominator: BigInt): Int =
    let guess = 53 - (bitLength(numerator) - bitLength(denominator))
    let raw = scaledTop(numerator, guess).quot(scaledBottom(denominator, guess))
    if raw >= (2 ** 53) then guess - 1 else guess

let roundedSignificand(numerator: BigInt, denominator: BigInt, scale: Int): BigInt =
    let dividend = scaledTop(numerator, scale)
    let divisor = scaledBottom(denominator, scale)
    roundedMagnitude(dividend, divisor, True)

let powerOfTwo(exponent: Int): Float = (2n ** exponent).toFloat()

let assemble(significand: BigInt, scale: Int): Float =
    let result = significand.toFloat()
    if scale >= 0 then
        let half = scale.quot(2)
        result / powerOfTwo(half) / powerOfTwo(scale - half)
    else
        let magnitude = -scale
        let half = magnitude.quot(2)
        result * powerOfTwo(half) * powerOfTwo(magnitude - half)

(** `decimal` as the nearest `Float`, rounded once with ties to even. *)
export let toFloat(decimal: Dec): Float =
    if decimal.unscaled == 0 then
        0.0
    else
        let negative = decimal.unscaled < 0
        let numerator = decimal.unscaled.abs()
        let denominator = tenTo(decimal.places)
        let aligned = alignedScale(numerator, denominator)
        let scale = if aligned > 1074 then 1074 else aligned
        let significand = roundedSignificand(numerator, denominator, scale)
        let carried = significand == (2 ** 53)
        let bits = if carried then 2 ** 52 else significand
        let exponent = if carried then scale - 1 else scale
        if bits == 0 or exponent < -971 then
            throw(FloatRangeError("Dec.toFloat: value does not fit in Float"))
        else
            let result = assemble(bits, exponent)
            if negative then -result else result

(** The number of decimal places retained by `decimal`. *)
export let places(decimal: Dec): Int = decimal.places
