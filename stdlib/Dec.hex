module Dec

(** Thrown when a function is asked for a negative number of decimal places, as
    in `price.withPlaces(-1)`. `message` says which function threw. *)
export fault NegativeDecimalPlacesFault(message: String)

(** Thrown when multiplying two decimals, or raising one to a power, would give
    a result with more decimal places than an `Int` can count. No decimal met in
    ordinary code has anywhere near that many. `message` says which operation
    threw. *)
export fault DecimalPlacesOverflowFault(message: String)

(** Thrown when a `Float` that is NaN or infinite is turned into a `Dec`, which
    can hold neither. `Dec.fromFloat` and `Dec.fromFloatEven` throw it.
    `message` says which function threw. *)
export fault DecRangeFault(message: String)

(** An exact decimal number, written with a `d` at the end, as in `1.50d`. Where
    a `Float` rounds, a `Dec` holds every decimal digit exactly, so
    `0.1d + 0.2d` is exactly `0.3d`, which makes it the type for money. A
    decimal remembers how many digits it has after the point: `1.50d` has two
    decimal places and shows as `"1.50"`. Adding and subtracting keep the larger
    number of places, and multiplying adds the two together. `==` compares the
    numbers alone, so `1.50d == 1.500d` is `True`. To compare the places as
    well, use `same`. *)
opaque record Dec = {
    unscaled: BigInt,
    places: Int,
}

let tenTo(value: Int): BigInt = 10n ** value

let requirePlaces(places: Int, operation: String): Int =
    if places < 0 then
        throw(NegativeDecimalPlacesFault("${operation}: decimal places cannot be negative"))
    else
        places

(** A decimal made from the digits of the integer `unscaled`, with the point
    put `places` digits from the right:\
    `Dec.create(150n, 2)` is `1.50d`.\
    Throws `NegativeDecimalPlacesFault` when `places` is negative. *)
export let create(unscaled: BigInt, places: Int): Dec =
    Dec({unscaled, places = requirePlaces(places, "Dec.create")})

(** All the digits of the decimal as one integer, with the point taken out:\
    `1.50d.unscaled()` is `150n`.\
    `places` says where the point was. *)
export let unscaled(decimal: Dec): BigInt = decimal.unscaled

(** Whether `left` and `right` are the same number with the same number of
    decimal places:\
    `1.50d.same(1.500d)` is `False`, where `1.50d == 1.500d` is `True`. *)
export let same(left: Dec, right: Dec): Bool =
    left.unscaled == right.unscaled and left.places == right.places

let align(value: Dec, retained: Int): BigInt =
    value.unscaled * tenTo(retained - value.places)

let roundedMagnitude(numerator: BigInt, denominator: BigInt, even: Bool): BigInt =
    let quotient = numerator.quot(denominator)
    let twiceRemainder = numerator.rem(denominator) * 2
    if twiceRemainder > denominator then
        quotient + 1
    else if twiceRemainder < denominator then
        quotient
    else if even and quotient.rem(2) == 0 then
        quotient
    else
        quotient + 1

let roundedRatio(numerator: BigInt, denominator: BigInt, even: Bool): BigInt =
    let negative = (numerator < 0 and denominator > 0) or
        (numerator > 0 and denominator < 0)
    let top = numerator.abs()
    let bottom = denominator.abs()
    let rounded = roundedMagnitude(top, bottom, even)
    if negative then -rounded else rounded

let changedPlaces(decimal: Dec, requested: Int, even: Bool, operation: String): Dec =
    let checked = requirePlaces(requested, operation)
    if decimal.unscaled == 0 then
        create(0n, checked)
    else if checked >= decimal.places then
        create(
            decimal.unscaled * tenTo(checked - decimal.places),
            checked
        )
    else
        create(
            roundedRatio(
                decimal.unscaled,
                tenTo(decimal.places - checked),
                even
            ),
            checked
        )

(** The decimal with exactly `places` digits after the point. Places that are
    added are filled with zeros. When places are removed the decimal is rounded
    to the nearest, and one exactly halfway is rounded away from zero:\
    `1.005d.withPlaces(2)` is `1.01d`.\
    To round a half to the even digit, use `withPlacesEven`. Throws
    `NegativeDecimalPlacesFault` when `places` is negative. *)
export let withPlaces(decimal: Dec, places: Int): Dec =
    changedPlaces(decimal, places, False, "Dec.withPlaces")

(** The decimal with exactly `places` digits after the point. Places that are
    added are filled with zeros. When places are removed the decimal is rounded
    to the nearest, and one exactly halfway is rounded so that its last digit
    is even:\
    `1.005d.withPlacesEven(2)` is `1.00d`.\
    Rounding a half this way keeps a long list of rounded amounts from creeping
    upward. To round a half away from zero, use `withPlaces`. Throws
    `NegativeDecimalPlacesFault` when `places` is negative. *)
export let withPlacesEven(decimal: Dec, places: Int): Dec =
    changedPlaces(decimal, places, True, "Dec.withPlacesEven")

let divided(left: Dec, right: Dec, requested: Int, even: Bool, operation: String): Dec =
    let checked = requirePlaces(requested, operation)
    if right.unscaled == 0 then
        throw(DivideByZeroFault("${operation}: divisor is zero"))
    else if left.unscaled == 0 then
        create(0n, checked)
    else
        // Cancel the operands' places first. Applying the requested result
        // scale as a separate exact factor avoids an overflowing scale sum.
        if right.places >= left.places then
            let numerator = left.unscaled * tenTo(right.places - left.places) * tenTo(checked)
            create(roundedRatio(numerator, right.unscaled, even), checked)
        else
            let numerator = left.unscaled * tenTo(checked)
            let denominator = right.unscaled * tenTo(left.places - right.places)
            create(roundedRatio(numerator, denominator, even), checked)

(** `left` divided by `right`, rounded to `places` digits after the point, with
    a result exactly halfway rounded away from zero:\
    `1d.divide(3d, 4)` is `0.3333d`.\
    A `Dec` has no `/`, because a division such as this one never ends, so
    `divide` asks how many places to keep. To round a half to the even digit,
    use `divideEven`. Throws `DivideByZeroFault` when `right` is zero. Throws
    `NegativeDecimalPlacesFault` when `places` is negative. *)
export let divide(left: Dec, right: Dec, places: Int): Dec =
    divided(left, right, places, False, "Dec.divide")

(** `left` divided by `right`, rounded to `places` digits after the point, with
    a result exactly halfway rounded so that its last digit is even:\
    `0.125d.divideEven(1d, 2)` is `0.12d`, where `divide` gives `0.13d`.\
    Throws `DivideByZeroFault` when `right` is zero. Throws
    `NegativeDecimalPlacesFault` when `places` is negative. *)
export let divideEven(left: Dec, right: Dec, places: Int): Dec =
    divided(left, right, places, True, "Dec.divideEven")

(** The nearest integer to the decimal, as a `BigInt`. A decimal exactly
    halfway between two integers goes to the one further from zero:\
    `2.5d.round()` is `3n`, and `(-2.5d).round()` is `-3n`.\
    To send a half to the even integer, use `roundEven`. To keep some decimal
    places, use `withPlaces`. *)
export let round(decimal: Dec): BigInt =
    if decimal.unscaled == 0 then 0n
    else roundedRatio(decimal.unscaled, tenTo(decimal.places), False)

(** The nearest integer to the decimal, as a `BigInt`. A decimal exactly
    halfway between two integers goes to the even one:\
    `2.5d.roundEven()` is `2n`, and `3.5d.roundEven()` is `4n`. *)
export let roundEven(decimal: Dec): BigInt =
    if decimal.unscaled == 0 then 0n
    else roundedRatio(decimal.unscaled, tenTo(decimal.places), True)

(** The decimal as a `BigInt` with the digits after the point dropped, which
    rounds toward zero:\
    `(-2.7d).trunc()` is `-2n`. *)
export let trunc(decimal: Dec): BigInt =
    if decimal.unscaled == 0 then 0n
    else decimal.unscaled.quot(tenTo(decimal.places))

(** The decimal rounded down to a `BigInt`, which is the nearest integer that
    is not greater:\
    `(-2.5d).floor()` is `-3n`. *)
export let floor(decimal: Dec): BigInt =
    if decimal.unscaled == 0 then 0n
    else
        let divisor = tenTo(decimal.places)
        let truncated = decimal.unscaled.quot(divisor)
        if decimal.unscaled < 0 and decimal.unscaled.rem(divisor) != 0 then
            truncated - 1
        else
            truncated

(** The decimal rounded up to a `BigInt`, which is the nearest integer that is
    not smaller:\
    `(-2.5d).ceil()` is `-2n`. *)
export let ceil(decimal: Dec): BigInt =
    if decimal.unscaled == 0 then 0n
    else
        let divisor = tenTo(decimal.places)
        let truncated = decimal.unscaled.quot(divisor)
        if decimal.unscaled > 0 and decimal.unscaled.rem(divisor) != 0 then
            truncated + 1
        else
            truncated

// A whole number as a `Dec`, with no places. `fromNat`, `fromInt` and `fromBigInt` all
// start here, so no rung of the tower borrows from the rung above it.
let fromWhole(value: BigInt): Dec = create(value, 0)

honor Num<Dec> =
    add(left, right) =
        let retained = if left.places > right.places then left.places else right.places
        create(align(left, retained) + align(right, retained), retained)

    multiply(left, right) =
        let limit: Int = 9_007_199_254_740_991
        if left.places > limit - right.places then
            throw(DecimalPlacesOverflowFault("Dec.multiply: decimal places overflow"))
        else
            create(left.unscaled * right.unscaled, left.places + right.places)

    fromNat(value) = fromWhole(BigInt.fromNat(value))

honor Signed<Dec> =
    subtract(left, right) =
        let retained = if left.places > right.places then left.places else right.places
        create(align(left, retained) - align(right, retained), retained)

    negate(decimal) = create(-decimal.unscaled, decimal.places)
    fromInt(value) = fromWhole(BigInt.fromInt(value))

honor FromBigInt<Dec> =
    fromBigInt(value) = fromWhole(value)

// The one representation of a number: trailing zeros removed while places
// remain, and every zero at `(0n, 0)`. Numerically equal decimals share this key
// and unequal ones never do, so `Eq` and `Hash` both read it and agree by
// construction: `3d` and `3.0d` are both `(3n, 0)`, while `5d` is `(5n, 0)` and
// `0.5d` is `(5n, 1)`.
let canonical(decimal: Dec): (BigInt, Int) =
    if decimal.unscaled == 0 then (0n, 0)
    else
        // Strip zeros in doubling strides, halving the stride when it overshoots,
        // so a long run of zeros costs a few divisions rather than one per zero.
        // A stride of one always succeeds under the loop's guard.
        var coefficient = decimal.unscaled
        var remainingPlaces = decimal.places
        var stride: Int = 1
        while remainingPlaces > 0 and coefficient.rem(10) == 0
            let count = if stride < remainingPlaces then stride else remainingPlaces
            let divisor = tenTo(count)
            if coefficient.rem(divisor) == 0 then
                coefficient := coefficient.quot(divisor)
                remainingPlaces := remainingPlaces - count
                stride := stride * 2
            else
                stride := if stride > 1 then stride.quot(2) else 1
        (coefficient, remainingPlaces)

honor Eq<Dec> =
    equals(left, right) =
        if left.places == right.places then
            left.unscaled == right.unscaled
        else
            canonical(left) == canonical(right)

honor Ord<Dec> =
    compare(left, right) =
        if left.unscaled == 0 and right.unscaled == 0 then
            Ordering.Equal
        else if left.unscaled == 0 then
            if right.unscaled < 0 then Ordering.Greater else Ordering.Less
        else if right.unscaled == 0 then
            if left.unscaled < 0 then Ordering.Less else Ordering.Greater
        else if left.unscaled < 0 and right.unscaled > 0 then
            Ordering.Less
        else if left.unscaled > 0 and right.unscaled < 0 then
            Ordering.Greater
        else
            let retained = if left.places > right.places then left.places else right.places
            let leftValue = align(left, retained)
            let rightValue = align(right, retained)
            if leftValue < rightValue then
                Ordering.Less
            else if leftValue > rightValue then
                Ordering.Greater
            else
                Ordering.Equal

honor Hash<Dec> =
    hash(decimal) = Hash.hash(canonical(decimal))

honor Real<Dec> =
    abs(decimal) = if decimal.unscaled < 0 then -decimal else decimal

    sign(decimal) =
        if decimal.unscaled == 0 then
            Sign.Zero
        else if decimal.unscaled < 0 then
            Sign.Negative
        else
            Sign.Positive

honor Pow<Dec> =
    pow(decimal, exponent) =
        if exponent < 0 then
            throw(NegativeExponentFault("Dec.pow: exponent cannot be negative"))
        else if exponent == 0 then
            create(1n, 0)
        else
            let limit: Int = 9_007_199_254_740_991
            let retained = decimal.places
            if retained > 0 and exponent > limit.quot(retained) then
                throw(DecimalPlacesOverflowFault("Dec.pow: decimal places overflow"))
            else
                create(decimal.unscaled ** exponent, retained * exponent)

honor Show<Dec> =
    show(decimal) =
        let negative = decimal.unscaled < 0
        let digits = decimal.unscaled.abs().show()
        let retained = decimal.places
        let digitCount = digits.length()
        let rendered =
            if retained == 0 then
                digits
            else if digitCount > retained then
                "${digits.dropLastN(retained)}.${digits.dropFirstN(digitCount - retained)}"
            else
                var zeroes = ""
                var count = retained - digitCount
                while count > 0
                    zeroes := "${zeroes}0"
                    count := count - 1
                "0.${zeroes}${digits}"
        if negative and decimal.unscaled != 0 then "-${rendered}" else rendered

// The exact binary64 conversion is shared in shape with `Rat.toFloat`: compute
// the correctly rounded significand using integers, then assemble one Float.
let bitLength(value: BigInt): Int =
    var high: Int = 1
    while (2 ** high) <= value
        high := high * 2
    var low: Int = if high == 1 then 0 else high.quot(2)
    while high - low > 1
        let middle = (low + high).quot(2)
        if (2 ** middle) <= value then low := middle else high := middle
    high

let scaledTop(value: BigInt, scale: Int): BigInt =
    if scale > 0 then value * (2 ** scale) else value

let scaledBottom(value: BigInt, scale: Int): BigInt =
    if scale < 0 then value * (2 ** (-scale)) else value

let alignedScale(numerator: BigInt, denominator: BigInt): Int =
    let guess = 53 - (bitLength(numerator) - bitLength(denominator))
    let raw = scaledTop(numerator, guess).quot(scaledBottom(denominator, guess))
    if raw >= (2 ** 53) then guess - 1 else guess

let roundedSignificand(numerator: BigInt, denominator: BigInt, scale: Int): BigInt =
    let dividend = scaledTop(numerator, scale)
    let divisor = scaledBottom(denominator, scale)
    roundedMagnitude(dividend, divisor, True)

let powerOfTwo(exponent: Int): Float = (2n ** exponent).toFloat()

let assemble(significand: BigInt, scale: Int): Float =
    let result = significand.toFloat()
    if scale >= 0 then
        let half = scale.quot(2)
        result / powerOfTwo(half) / powerOfTwo(scale - half)
    else
        let magnitude = -scale
        let half = magnitude.quot(2)
        result * powerOfTwo(half) * powerOfTwo(magnitude - half)

(** The decimal as a `Float`, the closest one to it. A `Float` cannot hold most
    decimals exactly, so the result may differ slightly from the decimal. Throws
    `FloatRangeFault` when the decimal is too large for a `Float`, or is not
    zero but too close to zero for one. *)
export let toFloat(decimal: Dec): Float =
    if decimal.unscaled == 0 then
        0.0
    else
        let negative = decimal.unscaled < 0
        let numerator = decimal.unscaled.abs()
        let denominator = tenTo(decimal.places)
        let aligned = alignedScale(numerator, denominator)
        let scale = if aligned > 1074 then 1074 else aligned
        let significand = roundedSignificand(numerator, denominator, scale)
        let carried = significand == (2 ** 53)
        let bits = if carried then 2 ** 52 else significand
        let exponent = if carried then scale - 1 else scale
        if bits == 0 or exponent < -971 then
            throw(FloatRangeFault("Dec.toFloat: value does not fit in Float"))
        else
            let result = assemble(bits, exponent)
            if negative then -result else result

// A finite float is exactly `significand * 2^-shift`, with `significand` a
// safe integer. Doubling or halving a float changes only its exponent, so
// scaling its magnitude into [2^52, 2^53) reads both parts exactly; the door then
// rounds that exact value once to the requested places, as `divide` does.
let fromFloatRounded(value: Float, requested: Int, even: Bool, operation: String): Dec =
    let checked = requirePlaces(requested, operation)
    if not value.isFinite() then
        throw(DecRangeFault("${operation}: value is not finite"))
    else if value == 0 then
        create(0n, checked)
    else
        var magnitude = if value < 0 then -value else value
        var shift: Int = 0
        while magnitude < 4503599627370496.0
            magnitude := magnitude * 2
            shift := shift + 1
        while magnitude >= 9007199254740992.0
            magnitude := magnitude / 2
            shift := shift - 1
        let significand = BigInt.fromInt(magnitude.trunc())
        let signed = if value < 0 then -significand else significand
        if shift <= 0 then
            create(signed * (2n ** (-shift)) * tenTo(checked), checked)
        else
            create(roundedRatio(signed * tenTo(checked), 2n ** shift, even), checked)

(** The float `value` as a decimal with `places` digits after the point,
    rounded to the nearest, with a half rounded away from zero:\
    `Dec.fromFloat(0.1 + 0.2, 2)` is `0.30d`.\
    What is rounded is the number the float really holds, which can be a little
    off the number that was written: `Dec.fromFloat(2.675, 2)` is `2.67d`,
    because the float is slightly less than 2.675. Throws `DecRangeFault` when
    `value` is NaN or infinite. Throws `NegativeDecimalPlacesFault` when
    `places` is negative. *)
export let fromFloat(value: Float, places: Int): Dec =
    fromFloatRounded(value, places, False, "Dec.fromFloat")

(** The float `value` as a decimal with `places` digits after the point,
    rounded to the nearest, with a half rounded so that its last digit is even:\
    `Dec.fromFloatEven(0.125, 2)` is `0.12d`, where `fromFloat` gives `0.13d`.\
    Throws `DecRangeFault` when `value` is NaN or infinite. Throws
    `NegativeDecimalPlacesFault` when `places` is negative. *)
export let fromFloatEven(value: Float, places: Int): Dec =
    fromFloatRounded(value, places, True, "Dec.fromFloatEven")

(** How many digits the decimal has after the point:\
    `1.50d.places()` is `2`. *)
export let places(decimal: Dec): Int = decimal.places

// `parse`'s two crossings (`spec/numeric-parsing.md`): the scan, which answers
// the unscaled integer and the place count, and the message.
extern from "hex:intrinsic"
    fun numberParseDec as scanText(text: String) -> Option((BigInt, Int))
    fun numberFormatMessage as formatMessage(text: String, phrase: String) -> String

(** Reads `text` as a `Dec`:\
    `Dec.parse^("1.50")` is `1.50d`.\
    The text is an optional `+` or `-`, then digits, then optionally a point
    with digits after it, with `_` allowed between two digits. A point needs a
    digit on each side. There is no `d` at the end and no exponent, so `1e2` is
    not accepted. The digits after the point are kept as written, so `"1.50"`
    has two decimal places, and text made by `show` reads back as the same
    decimal with the same places. Throws `NumberFormatError` when `text` is not
    written that way. A call that may throw carries a mark: `Dec.parse?(text)`
    gives `None` in place of throwing, and `assume Dec.parse^(text)` is for text
    that is known to be good. *)
export let parse(text: String): Dec = match scanText(text)
    Some((unscaled, places)) => create(unscaled, places)
    None => throw^(NumberFormatError(formatMessage(text, "is not a Dec")))
