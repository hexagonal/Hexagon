{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  // `property-seed.ts` is test infrastructure that lives under `src` only so
  // `npm run check` type-checks it; it is not part of the shipped compiler.
  "exclude": ["src/**/*.test.ts", "src/support/property-seed.ts"],
  "include": ["src/**/*.ts"]
}
