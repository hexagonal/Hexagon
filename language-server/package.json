{
  "name": "hexagon-language-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "hexagon-language-server": "./dist/server.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/server.cjs --banner:js=\"#!/usr/bin/env node\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.25.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
